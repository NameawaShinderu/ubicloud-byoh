#!/usr/bin/env ruby
# frozen_string_literal: true

minimum_time_alive = Integer(ENV.fetch("RESTART_MINIMUM_TIME_ALIVE", "3600"), 10)
# Upper bound of the pause before a respawn. A systemd unit that restarts
# respirate promptly sets it lower than the default.
max_sleep = Integer(ENV.fetch("RESTART_MAX_SLEEP", "10"), 10).clamp(1..)
require "json"

command = ARGV.dup.freeze
start_time = Time.now
shutting_down = false

iso_start = start_time.utc.strftime("%Y-%m-%dT%H:%M:%S%:z").freeze
puts JSON.generate(restarter: {
  start_time: iso_start,
  startup: {
    command:,
    minimum_time_alive:,
  },
})

# One trap for the whole run. It signals only a child that has not been
# reaped yet, so a TERM between children can never reach a reused pid.
child_pid = nil
Signal.trap("TERM") do
  shutting_down = true
  if (pid = child_pid)
    begin
      Process.kill(:TERM, pid)
    rescue Errno::ESRCH
      # The child exited but is not reaped yet; Process.wait returns.
    end
  end
end

loop do
  child_pid = Process.spawn(*command)
  # TERM that arrived before child_pid was set found no child to signal.
  Process.kill(:TERM, child_pid) if shutting_down
  Process.wait(child_pid)
  status = $?
  child_pid = nil

  # Extra newline to prevent blending with subprocess just in
  # case. Done as a separate system call, to be extra-accommodating to
  # loggers that may want process things one system call at a time:
  # below PIPE_BUF each write() matches with a read().
  puts

  puts JSON.generate(restarter: {
    start_time: iso_start,
    command_exit: {
      command:,
      exitstatus: status.exitstatus,
      pid: status.pid,
      success: status.success?,
    },
  })
  # A child killed by a signal has no exit status.
  exit(status.exitstatus || 128 + status.termsig) if shutting_down

  sleep(rand(1..max_sleep))

  # TERM arrived during the sleep: stop instead of spawning a child that
  # nothing will signal again.
  exit if shutting_down

  if Time.now - start_time > minimum_time_alive
    puts JSON.generate(restarter: {start_time: iso_start,
                                   shutdown: {
                                     command:,
                                     minimum_time_alive:,
                                   }})
    exit
  end
end
