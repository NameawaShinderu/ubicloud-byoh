#!/usr/bin/env ruby
# frozen_string_literal: true

# Registers a "bring your own host" (BYOH) machine in a BYOH location. The
# logic lives in lib/byoh_registration_cli.rb and lib/byoh_registration.rb.
# Must be run on a control-plane node with DB access; creates the
# Sshable/VmHost/HostProvider/Address/Strand rows that drive
# Prog::Vm::HostNexus bootstrap.
#
# With --ssh-key (a key already in root's authorized_keys on the host)
# it first runs host preflight (docs/byoh/PLATFORMS.md PF1-PF21) as root
# over that key, refuses a host that fails it, and pins the host keys it
# met. With a generated key it skips preflight and says so.
#
# Example:
#
#   bundle exec bin/register-byoh-host \
#     --main-ip 192.168.1.10 \
#     --location byoh-homelab \
#     --ssh-key ~/.ssh/byoh_data \
#     --routed-network 198.51.100.0/29,exposure=public \
#     --routed-network 2001:db8:feed::/64 \
#     --bmc-endpoint https://192.168.1.11 \
#     --bmc-user admin \
#     --bmc-pass-env HOMELAB_BMC_PASS \
#     --bmc-system-id 1
#
# Uses RACK_ENV from the environment (defaults to "development").

unless ENV["RACK_ENV"]
  ENV["RACK_ENV"] = "development"
end

ENV["SKIP_LIT_REQUIRE_FROZEN"] = "1"
require "bundler"
if ENV["RACK_ENV"] == "production"
  Bundler.setup(:default)
else
  Bundler.setup(:default, :development)
end

require "logger"
require_relative "../db"
require_relative "../loader"

exit ByohRegistrationCli.new.run(ARGV)
