#!/usr/bin/env ruby
# frozen_string_literal: true

# Operator commands for registered BYOH hosts: moving an empty host into or
# out of a BYOH location, reinstalling its egress NAT table, relearning its
# disk ids or GPUs, and exporting the operator audit log. The logic
# lives in lib/byoh_host_cli.rb; run with --help for the commands.
#
# Example:
#
#   bundle exec bin/byoh-host move-location --host vh... \
#     --location byoh-aws-aps1 --empty-only
#
# Uses RACK_ENV from the environment (defaults to "development").

unless ENV["RACK_ENV"]
  ENV["RACK_ENV"] = "development"
end

ENV["SKIP_LIT_REQUIRE_FROZEN"] = "1"
require "bundler"
if ENV["RACK_ENV"] == "production"
  Bundler.setup(:default)
else
  Bundler.setup(:default, :development)
end

require "logger"
require_relative "../db"
require_relative "../loader"

exit ByohHostCli.new.run(ARGV)
