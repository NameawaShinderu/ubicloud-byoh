#!/usr/bin/env ruby
# frozen_string_literal: true

# Operator commands for BYOH hosts: adding one over the operator's SSH
# login (add, preflight, watch; lib/byoh_host_add.rb), moving an empty
# host into or out of a BYOH location, reinstalling its egress NAT
# table, relearning its disk ids or GPUs, and exporting the operator
# audit log. The logic lives in lib/byoh_host_cli.rb; run with --help
# for the commands.
#
# Examples:
#
#   bundle exec bin/byoh-host add --site byoh-homelab --ssh ubuntu@192.168.1.10 \
#     --ssh-key ~/.ssh/id_ed25519 --pool-file pools.yaml
#
#   bundle exec bin/byoh-host move-location --host vh... \
#     --location byoh-aws-aps1 --empty-only
#
# Uses RACK_ENV from the environment (defaults to "development").

unless ENV["RACK_ENV"]
  ENV["RACK_ENV"] = "development"
end

ENV["SKIP_LIT_REQUIRE_FROZEN"] = "1"
require "bundler"
if ENV["RACK_ENV"] == "production"
  Bundler.setup(:default)
else
  Bundler.setup(:default, :development)
end

require "logger"
require_relative "../db"
require_relative "../loader"

exit ByohHostCli.new.run(ARGV)
