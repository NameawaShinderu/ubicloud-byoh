#!/usr/bin/env ruby
# frozen_string_literal: true

# Operator commands for the address pools of registered BYOH hosts: list,
# export, add, remove, remap, annotate, ipv6 set, verify and trace. The
# logic lives in lib/byoh_pool_cli.rb and lib/byoh_pool.rb; run with
# --help for the commands.
#
# Example:
#
#   bundle exec bin/byoh-pool export --host vh... --set exposure=nat \
#     --external-map addresses.json > pools.yaml
#   bundle exec bin/byoh-pool annotate --host vh... --pool-file pools.yaml
#
# Uses RACK_ENV from the environment (defaults to "development").

unless ENV["RACK_ENV"]
  ENV["RACK_ENV"] = "development"
end

ENV["SKIP_LIT_REQUIRE_FROZEN"] = "1"
require "bundler"
if ENV["RACK_ENV"] == "production"
  Bundler.setup(:default)
else
  Bundler.setup(:default, :development)
end

require "logger"
require_relative "../db"
require_relative "../loader"

exit ByohPoolCli.new.run(ARGV)
