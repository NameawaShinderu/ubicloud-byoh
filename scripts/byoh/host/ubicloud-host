#!/bin/bash
# ubicloud-host: runs on a would-be BYOH data-plane host and reports what
# the control plane needs to know before registering it.
#
#   ubicloud-host preflight [--json] [--nonce N] [--main-ip IP] [--cp-ip IP]
#                           [--boot-image-url URL]... [--images N]
#                           [--vm-disk-gib N] [--standalone]
#   ubicloud-host version
#
# preflight gathers facts and gives verdicts only for the host-local
# checks of docs/byoh/PLATFORMS.md (PF1-PF21) that need no pool or
# control-plane knowledge. The control plane (lib/byoh_host_preflight.rb)
# judges the rest from the facts: PF17 and contract C5 against the pools,
# PF20 boot images, PF21 services. --standalone adds two checks for a run
# without a control plane: the main IP is local, and there is exactly one
# IPv4 default route.
#
# It is strictly read-only: no apt-get update, no mkdir, no sudo that can
# prompt (only `sudo -n`, for dmidecode, sshd -T and smartctl). Every
# external command reads /dev/null, so `ssh host bash -s < ubicloud-host`
# works.
#
# --json prints one line per check or fact:
#   UBIPF:<nonce> {"kind":"check","id":"PF3","status":"fail","detail":"...","fix":"..."}
#   UBIPF:<nonce> {"kind":"fact","id":"arch","value":"x86_64"}
# The control plane ignores lines without its nonce (.bashrc noise, sudo
# warnings). Statuses are pass, info, warn and fail.
#
# Exit status: 0 when the checks ran (verdicts are in the output), 2 on a
# usage error, 3 on an internal error.
#
# Test mode: --fixture-root DIR together with UBICLOUD_HOST_TEST_ROOT=DIR
# (the same value) reads every file under DIR and every command's output
# from DIR/cmd/<key> (exit status in DIR/cmd/<key>.rc, default 0; a
# missing key is a missing command). DIR/bin/<name> marks a tool as
# installed. See scripts/byoh/test/preflight-fixtures.sh.

VERSION=1

# Bring-up installs these (prog/bootstrap_rhizome.rb,
# rhizome/host/bin/prep_host.rb, prog/install_dnsmasq.rb,
# rhizome/host/bin/setup-sysstat; rhizome/host/spec/ubicloud_host_parity_spec.rb
# keeps the list complete): the apt simulation proves the archive serves
# them.
PREP_PACKAGES=(ruby-bundler qemu-utils mtools acl smartmontools nvme-cli systemd-coredump jq ethtool make gcc libaio-dev sysstat nftables dmidecode pciutils)
# PrepHost's first download (rhizome/host/lib/htcat_setup.rb). GitHub
# redirects release downloads to release-assets.githubusercontent.com, so
# following the redirect proves egress to both hosts.
HTCAT_VERSION=2.0.0-ubi1
# Units whose firewall rules or bridges collide with the nftables rules
# rhizome installs (PLATFORMS.md PF16).
CONFLICTING_UNITS=(docker ufw tailscaled k3s libvirtd)
PF3_FIX="enable hardware virtualization (VT-x/AMD-V) for this machine, or nested virtualization with a host-passthrough CPU model if it is a VM; see docs/byoh/TROUBLESHOOTING.md#pf3"

R=""
JSON=0
NONCE=""
MAIN_IP=""
CP_IP=""
STANDALONE=0
IMAGES=1
VM_DISK_GIB=0
URLS=()

usage() {
  echo "usage: ubicloud-host preflight [--json] [--nonce N] [--main-ip IP] [--cp-ip IP] [--boot-image-url URL]... [--images N] [--vm-disk-gib N] [--standalone]" >&2
  echo "       ubicloud-host version" >&2
  exit 2
}

usage_error() {
  echo "ubicloud-host: $*" >&2
  exit 2
}

internal_error() {
  echo "ubicloud-host: internal error: $*" >&2
  exit 3
}

# --- input helpers ---------------------------------------------------

# Reads a file (under the fixture root in test mode).
rd() {
  cat -- "$R$1" 2>/dev/null
}

# Is the named tool installed?
have() {
  if [[ -n $R ]]; then
    [[ -e $R/bin/$1 ]]
  else
    command -v "$1" >/dev/null 2>&1
  fi
}

# run_cmd KEY CMD [ARG...]: the command's stdout (stderr dropped). In
# test mode, DIR/cmd/KEY instead. Returns 127 when it is missing.
run_cmd() {
  local key=$1
  shift
  if [[ -n $R ]]; then
    [[ -f $R/cmd/$key ]] || return 127
    cat -- "$R/cmd/$key"
    local rc=0
    [[ -f $R/cmd/$key.rc ]] && rc=$(<"$R/cmd/$key.rc")
    return "$rc"
  fi
  command -v "$1" >/dev/null 2>&1 || return 127
  "$@" </dev/null 2>/dev/null
}

# As run_cmd, as root: directly when root, else `sudo -n`, which fails
# rather than prompts.
run_root() {
  local key=$1
  shift
  if [[ -n $R ]] || ((EUID == 0)); then
    run_cmd "$key" "$@"
  else
    command -v "$1" >/dev/null 2>&1 || return 127
    run_cmd "$key" sudo -n "$@"
  fi
}

# Is PATH a character device? A fixture marks one with PATH.chardev.
chardev() {
  if [[ -n $R ]]; then
    [[ -e $R$1.chardev ]]
  else
    [[ -c $1 ]]
  fi
}

# kv KEY LINE: the value of KEY="..." in an lsblk -P line.
kv() {
  sed -nE "s/(^|.* )$1=\"([^\"]*)\".*/\2/p" <<<"$2"
}

# --- output ----------------------------------------------------------

json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177')
  printf '"%s"' "$s"
}

ROWS=()

check() {
  local id=$1 status=$2 detail=$3 fix=${4:-}
  if ((JSON)); then
    printf 'UBIPF:%s {"kind":"check","id":%s,"status":%s,"detail":%s,"fix":%s}\n' \
      "$NONCE" "$(json_str "$id")" "$(json_str "$status")" "$(json_str "$detail")" "$(json_str "$fix")"
  else
    ROWS+=("$(printf '%-5s %-18s %s' "$status" "$id" "$detail")")
    [[ -n $fix ]] && ROWS+=("$(printf '%24s fix: %s' "" "$fix")")
  fi
}

# fact ID JSON-VALUE
fact() {
  if ((JSON)); then
    printf 'UBIPF:%s {"kind":"fact","id":%s,"value":%s}\n' "$NONCE" "$(json_str "$1")" "$2"
  fi
}

fact_str() {
  fact "$1" "$(json_str "$2")"
}

# A raw JSON document from a command, or null when it printed nothing
# that looks like one. ip -j prints a single line.
fact_json() {
  local id=$1 value=$2
  value=${value//$'\n'/}
  if [[ $value == \[* || $value == \{* ]]; then
    fact "$id" "$value"
  else
    fact "$id" null
  fi
}

# --- checks ----------------------------------------------------------

ARCH=""
CPUINFO=""

pf1_os() {
  local id version
  ARCH=$(run_cmd uname-m uname -m)
  id=$(rd /etc/os-release | sed -n 's/^ID=//p' | tr -d '"')
  version=$(rd /etc/os-release | sed -n 's/^VERSION_ID=//p' | tr -d '"')
  fact_str arch "$ARCH"
  fact_str os_version "$id $version"
  if [[ $id != ubuntu || $version != 24.04 ]]; then
    check PF1 fail "OS is ${id:-unknown} ${version:-unknown}, not Ubuntu 24.04" "reinstall the host with Ubuntu 24.04 LTS"
  elif [[ $ARCH != x86_64 && $ARCH != aarch64 ]]; then
    check PF1 fail "architecture ${ARCH:-unknown} is not x86_64 or aarch64"
  else
    check PF1 pass "Ubuntu 24.04 on $ARCH"
  fi
}

# Mirrors rhizome/host/lib/kvm_check.rb (PrepHost runs it after
# registration), and also refuses the generic kvm64/qemu64 CPU models,
# which lack features guests built for x86-64-v2 need.
pf3_kvm() {
  local model
  CPUINFO=$(rd /proc/cpuinfo)
  model=$(sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' <<<"$CPUINFO" | head -1)
  if [[ $ARCH == x86_64 ]] && grep -Eq '^(Common KVM processor|QEMU Virtual CPU|kvm64|qemu64)' <<<"$model"; then
    check PF3 fail "kvm64-class CPU model ($model)" "$PF3_FIX"
  elif ! chardev /dev/kvm; then
    check PF3 fail "no /dev/kvm" "$PF3_FIX"
  elif [[ $ARCH == x86_64 ]] && ! grep -Eq '^flags[[:space:]]*:.*\b(vmx|svm)\b' <<<"$CPUINFO"; then
    check PF3 fail "the CPU has neither the vmx nor the svm flag" "$PF3_FIX"
  else
    check PF3 pass "/dev/kvm present${model:+ ($model)}"
  fi
}

pf4_pdpe1gb() {
  if [[ $ARCH != x86_64 ]]; then
    check PF4 pass "1G pages need no CPU flag on $ARCH"
  elif grep -Eq '^flags[[:space:]]*:.*\bpdpe1gb\b' <<<"$CPUINFO"; then
    check PF4 pass "pdpe1gb flag present"
  else
    check PF4 fail "the CPU lacks the pdpe1gb flag, so it cannot use 1G hugepages" "another machine, or a VM CPU model that passes pdpe1gb through (host-passthrough)"
  fi
}

pf5_grub() {
  if [[ -f $R/etc/default/grub ]] && have update-grub; then
    check PF5 pass "/etc/default/grub and update-grub present"
  else
    check PF5 fail "/etc/default/grub or update-grub is missing; the host must boot with GRUB" "hugepages are set on the kernel command line through GRUB (prog/setup_hugepages.rb)"
  fi
}

MEM_GIB=0

# The memory LearnMemory records: the dmidecode device sizes in whole
# GiB, else MemTotal rounded up. Then the hugepage count SetupHugepages
# reserves from it.
pf6_pf7_memory() {
  local out rc lines line n unit mib=0 bad="" kib
  out=$(run_root dmidecode dmidecode -t 17)
  rc=$?
  lines=$(grep -E '^[[:space:]]*Size: [0-9]' <<<"$out")
  if ((rc != 0)) || [[ -z $lines ]]; then
    if ((rc == 127)); then
      check PF6 info "dmidecode is not installed; using MemTotal"
    elif ((rc != 0)); then
      check PF6 info "dmidecode failed (it needs root); using MemTotal"
    else
      check PF6 info "dmidecode lists no memory device; using MemTotal"
    fi
  else
    while read -r line; do
      n=$(awk '{print $2}' <<<"$line")
      unit=$(awk '{print $3}' <<<"$line")
      case $unit in
        kB) mib=$((mib + n / 1024)) ;;
        MB) mib=$((mib + n)) ;;
        GB) mib=$((mib + n * 1024)) ;;
        TB) mib=$((mib + n * 1024 * 1024)) ;;
        *) bad="$bad $unit" ;;
      esac
    done <<<"$lines"
    if [[ -n $bad ]]; then
      check PF6 fail "dmidecode reports a memory size in an unknown unit:$bad" "LearnMemory refuses it; report the dmidecode -t 17 output"
    else
      MEM_GIB=$((mib / 1024))
      check PF6 pass "dmidecode: $MEM_GIB GiB installed"
    fi
  fi

  if ((MEM_GIB == 0)); then
    kib=$(rd /proc/meminfo | sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\) kB$/\1/p')
    MEM_GIB=$(((${kib:-0} + 1048575) / 1048576))
  fi
  fact mem_gib "$MEM_GIB"

  local pages=$((MEM_GIB * 42 / 43 - 5))
  ((pages < 0)) && pages=0
  if ((pages < 8)); then
    check PF7 fail "$MEM_GIB GiB of memory gives $pages 1G hugepages; at least 8 are needed" "a host with at least 15 GiB of memory"
  elif ((pages < 16)); then
    check PF7 warn "$MEM_GIB GiB of memory gives $pages 1G hugepages, room for few VMs"
  else
    check PF7 pass "$MEM_GIB GiB of memory gives $pages 1G hugepages"
  fi
}

# Two groups of CPUs whose cpu_capacity or cpuinfo_max_freq differ by
# more than 20% are performance and efficiency cores (arm big.LITTLE,
# AMD Zen 5 with Zen 5c). The margin ignores the few percent Intel Turbo
# Boost Max 3.0 gives its favoured cores.
spread() {
  local min="" max="" v
  for v in "$@"; do
    [[ $v =~ ^[0-9]+$ ]] || continue
    if [[ -z $min ]] || ((v < min)); then min=$v; fi
    if [[ -z $max ]] || ((v > max)); then max=$v; fi
  done
  [[ -n $min ]] && ((min > 0 && max * 5 > min * 6))
}

pf8_cpu() {
  local out rc online=() offline=() line cpu socket core on hybrid="" caps=() freqs=() c
  out=$(run_cmd lscpu lscpu -a -p=CPU,NODE,SOCKET,CORE,ONLINE)
  rc=$?
  if ((rc != 0)); then
    check PF-min-cpu fail "lscpu failed (exit $rc)"
    check PF8 fail "lscpu failed (exit $rc)"
    check PF8-hybrid fail "lscpu failed (exit $rc)"
    fact cpus_online 0
    return
  fi
  # Threads per core count online CPUs only: lscpu gives an offline CPU
  # no socket or core. With any CPU offline the thread-count rule is
  # skipped, since an offline sibling would look like a smaller core;
  # PF8 warns about offline CPUs instead.
  local -A threads=()
  while IFS=, read -r cpu _ socket core on; do
    [[ $cpu == \#* || -z $cpu ]] && continue
    if [[ $on == Y ]]; then
      online+=("$cpu")
      threads["$socket,$core"]=$((${threads["$socket,$core"]:-0} + 1))
    else
      offline+=("$cpu")
    fi
  done <<<"$out"
  fact cpus_online "${#online[@]}"

  if ((${#online[@]} < 2)); then
    check PF-min-cpu fail "${#online[@]} online CPU(s); at least 2 are needed" "give the machine at least 2 CPUs"
  else
    check PF-min-cpu pass "${#online[@]} online CPUs"
  fi

  if ((${#offline[@]})); then
    check PF8 warn "${#offline[@]} CPU(s) offline (${offline[*]}); only online CPUs are used"
  else
    check PF8 pass "all CPUs online"
  fi

  if [[ -e $R/sys/devices/cpu_atom || -e $R/sys/devices/cpu_core ]]; then
    hybrid="Intel hybrid CPU (cpu_core and cpu_atom PMUs)"
  elif ((${#offline[@]} == 0)) && (($(printf '%s\n' "${threads[@]}" | sort -u | wc -l) > 1)); then
    hybrid="cores have different thread counts ($(printf '%s\n' "${threads[@]}" | sort -nu | tr '\n' ' ' | sed 's/ $//') threads)"
  else
    for c in "${online[@]}"; do
      caps+=("$(rd "/sys/devices/system/cpu/cpu$c/cpu_capacity")")
      freqs+=("$(rd "/sys/devices/system/cpu/cpu$c/cpufreq/cpuinfo_max_freq")")
    done
    if spread "${caps[@]}"; then
      hybrid="CPUs have different cpu_capacity (performance and efficiency cores)"
    elif spread "${freqs[@]}"; then
      hybrid="CPUs have maximum frequencies more than 20% apart (performance and efficiency cores)"
    fi
  fi
  if [[ -n $hybrid ]]; then
    check PF8-hybrid fail "$hybrid" "VMs would get a mix of fast and slow cores; pass --accept-check PF8-hybrid to use the host anyway"
  else
    check PF8-hybrid pass "uniform cores"
  fi
}

pf9_cgroup() {
  local fs
  fs=$(run_cmd stat-cgroup stat -fc %T /sys/fs/cgroup)
  if [[ $fs != cgroup2fs ]]; then
    check PF9 fail "/sys/fs/cgroup is ${fs:-unknown}, not cgroup v2" "boot with the unified cgroup hierarchy (the Ubuntu 24.04 default)"
  elif ! grep -qw cpuset <<<"$(rd /sys/fs/cgroup/cgroup.controllers)"; then
    check PF9 fail "the cpuset controller is not available in cgroup v2"
  else
    check PF9 pass "cgroup v2 with cpuset"
  fi
}

STORAGE_DISKS=()

# /var/storage need not exist yet; judge the filesystem it will be on.
storage_path() {
  local p=/var/storage
  while [[ $p != / && ! -e $R$p ]]; do
    p=$(dirname "$p")
  done
  echo "$p"
}

pf10_storage() {
  local path src fstype majmin rootsrc avail need dev
  path=$(storage_path)
  read -r src fstype majmin <<<"$(run_cmd findmnt-storage findmnt -nro SOURCE,FSTYPE,MAJ:MIN --target "$path")"
  read -r rootsrc _ <<<"$(run_cmd findmnt-root findmnt -nro SOURCE,FSTYPE --target /)"
  fact_str storage_fstype "${fstype:-}"

  if [[ $fstype == zfs ]]; then
    check PF10-zfs fail "/var/storage would be on ZFS ($src), which BYOH storage does not support" "mount an ext4 or xfs filesystem at /var/storage, or pass a blank disk with ubicloud-host storage-disk"
  else
    check PF10-zfs pass "not ZFS"
  fi
  if [[ $fstype == btrfs ]]; then
    check PF10-btrfs fail "/var/storage would be on btrfs ($src); write-through detection does not work there (UNVERIFIED)" "mount an ext4 or xfs filesystem at /var/storage, or pass --accept-check PF10-btrfs"
  else
    check PF10-btrfs pass "not btrfs"
  fi

  avail=$(run_cmd df-storage df -BG --output=avail "$path" | tail -1 | tr -dc 0-9)
  need=$((5 + 4 * IMAGES + VM_DISK_GIB))
  if [[ -z $src || -z $avail ]]; then
    check PF10 fail "cannot find the filesystem of $path"
  elif ((avail < need)); then
    check PF10 fail "$path has ${avail}G free; $need G are needed (5 + 4 per boot image + VM disks)" "grow the filesystem or mount a larger one at /var/storage"
  elif [[ $src == "$rootsrc" ]]; then
    check PF10 warn "/var/storage shares the root filesystem ($src, ${avail}G free); a full disk stops the host"
  else
    check PF10 pass "$src ($fstype), ${avail}G free"
  fi

  # As lib/byoh_device_identity.rb: /dev/root resolves through its device
  # number; btrfs has an anonymous one (major 0) and a [/subvolume] suffix.
  if [[ $majmin =~ ^[1-9][0-9]*:[0-9]+$ ]]; then
    dev=/dev/block/$majmin
  else
    dev=${src%%\[*}
  fi
  local line name type
  while read -r line; do
    name=$(kv NAME "$line")
    type=$(kv TYPE "$line")
    [[ $type == disk && -n $name ]] && STORAGE_DISKS+=("$name")
  done <<<"$(run_cmd lsblk-storage lsblk -nPso NAME,TYPE "$dev")"
}

pf11_blank_disks() {
  local out line name type fstype mounts pkname blank=()
  local -A parents=()
  out=$(run_cmd lsblk lsblk -nPo NAME,TYPE,FSTYPE,MOUNTPOINTS,PKNAME)
  while read -r line; do
    pkname=$(kv PKNAME "$line")
    [[ -n $pkname ]] && parents[$pkname]=1
  done <<<"$out"
  while read -r line; do
    name=$(kv NAME "$line")
    type=$(kv TYPE "$line")
    fstype=$(kv FSTYPE "$line")
    mounts=$(kv MOUNTPOINTS "$line")
    [[ $type == disk && -z $fstype && -z $mounts && -z ${parents[$name]:-} ]] && blank+=("$name")
  done <<<"$out"
  if ((${#blank[@]})); then
    check PF11 info "blank disk(s) not used for VM storage: ${blank[*]}" "to use one, prepare it with: ubicloud-host storage-disk /dev/<disk>"
  else
    check PF11 pass "no blank unused disk"
  fi
}

pf12_pf13_disks() {
  local links d missing=() smart rc failing=() unknown=()
  links=$(run_cmd byid find /dev/disk/by-id -mindepth 1 -maxdepth 1 -type l -printf '%f %l\n')
  for d in "${STORAGE_DISKS[@]}"; do
    grep -Eq "^(wwn-|nvme-eui\.|nvme-|ata-|scsi-|virtio-)[^ ]* (\.\./)*$d\$" <<<"$links" || missing+=("$d")
  done
  if ((${#STORAGE_DISKS[@]} == 0)); then
    check PF12 info "no disk found under /var/storage"
  elif ((${#missing[@]})); then
    check PF12 info "no /dev/disk/by-id link for ${missing[*]}; the host records the kernel name, which can change across reboots"
  else
    check PF12 pass "storage disk(s) ${STORAGE_DISKS[*]} have by-id links"
  fi

  if ! have smartctl; then
    check PF13 info "smartctl is not installed yet (PrepHost installs it)"
    return
  fi
  for d in "${STORAGE_DISKS[@]}"; do
    smart=$(run_root "smartctl-$d" smartctl -j -H "/dev/$d")
    rc=$?
    if grep -A2 '"smart_status"' <<<"$smart" | grep -Eq '"passed": *false'; then
      failing+=("$d")
    elif ((rc == 127)) || [[ -z $smart ]]; then
      unknown+=("$d")
    fi
  done
  if ((${#failing[@]})); then
    check PF13 fail "SMART reports a failing disk: ${failing[*]}" "replace the disk"
  elif ((${#unknown[@]})); then
    check PF13 info "no SMART data for ${unknown[*]} (smartctl needs root)"
  else
    check PF13 pass "no failing disk"
  fi
}

# As lib/byoh_health_probe.rb clock_ok?.
pf14_clock() {
  local cs virt
  cs=$(rd /sys/devices/system/clocksource/clocksource0/available_clocksource)
  virt=$(run_cmd virt systemd-detect-virt)
  if [[ $ARCH == aarch64 ]]; then
    if grep -qw arch_sys_counter <<<"$cs"; then
      check PF14 pass "arch_sys_counter available"
      return
    fi
  elif grep -qw tsc <<<"$cs"; then
    check PF14 pass "tsc available"
    return
  elif grep -Eqw 'kvm-clock|hyperv_clocksource_tsc_page' <<<"$cs" && [[ -n $virt && $virt != none ]]; then
    check PF14 pass "paravirtual clocksource on a $virt guest"
    return
  fi
  check PF14 warn "clocksources '${cs% }' include no stable one; bin/monitor would mark the host down"
}

pf15_egress() {
  local lists out rc url failed=() urls
  lists=$(find "$R/var/lib/apt/lists" -maxdepth 1 -name '*_Packages' 2>/dev/null | head -1)
  if [[ -z $lists ]]; then
    check PF15-apt warn "the apt package lists are empty, so the packages could not be checked" "PrepHost runs apt-get update; or run it now"
  else
    out=$(run_cmd apt-get apt-get -s install "${PREP_PACKAGES[@]}")
    rc=$?
    if ((rc == 0)); then
      check PF15-apt pass "the archive serves the PrepHost packages"
    else
      check PF15-apt fail "apt-get -s install failed: $(grep -m1 '^E:' <<<"$out")" "fix the apt sources, or run apt-get update"
    fi
  fi

  local deb_arch=amd64
  [[ $ARCH == aarch64 ]] && deb_arch=arm64
  urls=("https://github.com/ubicloud/htcat/releases/download/v${HTCAT_VERSION}/htcat_${HTCAT_VERSION}_linux_${deb_arch}.tar.gz"
    https://cloud-images.ubuntu.com "${URLS[@]}")
  for url in "${urls[@]}"; do
    run_cmd curl curl -sfIL --max-time 20 -o /dev/null "$url" >/dev/null || failed+=("$url")
  done
  if ((${#failed[@]})); then
    check PF15-egress fail "cannot reach ${failed[*]}" "the host needs outbound HTTPS to GitHub release downloads (github.com and release-assets.githubusercontent.com) and the boot image mirrors"
  else
    check PF15-egress pass "reached ${#urls[@]} URL(s)"
  fi
}

pf16_coexistence() {
  local unit active
  active=$(run_cmd systemctl-active systemctl is-active "${CONFLICTING_UNITS[@]}")
  local i=0 states=()
  mapfile -t states <<<"$active"
  for unit in "${CONFLICTING_UNITS[@]}"; do
    if [[ $unit == ufw ]]; then
      # ufw.service is a oneshot that stays active even when it skipped
      # loading rules; ENABLED in ufw.conf decides whether it loads them.
      if grep -Eqi '^[[:space:]]*ENABLED[[:space:]]*=[[:space:]]*"?yes"?[[:space:]]*$' <<<"$(rd /etc/ufw/ufw.conf)"; then
        check PF16-ufw fail "ufw is enabled (ENABLED=yes in /etc/ufw/ufw.conf); its firewall rules can conflict with the host's nftables rules" "ufw disable, or pass --accept-check PF16-ufw"
      else
        check PF16-ufw pass "ufw not enabled"
      fi
    elif [[ ${states[$i]:-} == active ]]; then
      check "PF16-$unit" fail "$unit is active; its firewall rules can conflict with the host's nftables rules" "stop and disable $unit, or pass --accept-check PF16-$unit"
    else
      check "PF16-$unit" pass "$unit not active"
    fi
    i=$((i + 1))
  done

  if [[ -e $R/etc/pve ]] || have pveversion; then
    check PF16-pve fail "this looks like a Proxmox node; point --ssh at the data-plane VM" "run the data plane in a VM on the node (docs/byoh/platforms/proxmox.md)"
  else
    check PF16-pve pass "not a Proxmox node"
  fi

  local user
  if [[ -n $R ]]; then
    user=$(grep '^rhizome:' "$R/etc/passwd" 2>/dev/null)
  else
    user=$(getent passwd rhizome </dev/null)
  fi
  if [[ -n $user ]]; then
    check PF16-rhizome-user fail "a rhizome user exists; registration deletes it with its home directory" "use a host without a rhizome user"
  else
    check PF16-rhizome-user pass "no rhizome user"
  fi
}

# As Prog::LearnPci#byoh_records: an NVIDIA device is used only when
# every member of its IOMMU group is on vfio-pci, pci-stub, no driver, or
# a PCI bridge.
pf19_gpu() {
  local out rc
  out=$(run_cmd lspci lspci -vnmmk -D)
  rc=$?
  if ((rc == 127)); then
    check PF19 info "lspci is not installed (PrepHost installs pciutils)"
    return
  fi
  local blocked
  blocked=$(awk -F'\t' '
    function flush() {
      if (slot != "" && group != "") {
        n[group]++; s[group, n[group]] = slot; v[group, n[group]] = vendor
        c[group, n[group]] = class; d[group, n[group]] = driver
      }
      slot = ""; group = ""; vendor = ""; class = ""; driver = ""
    }
    /^$/ { flush(); next }
    $1 == "Slot:" { slot = $2 } $1 == "Vendor:" { vendor = $2 } $1 == "Class:" { class = $2 }
    $1 == "Driver:" { driver = $2 } $1 == "IOMMUGroup:" { group = $2 }
    END {
      flush()
      for (g in n) for (i = 1; i <= n[g]; i++) {
        if (v[g, i] != "10de" || c[g, i] == "0604") continue
        ok = 1
        for (j = 1; j <= n[g]; j++) {
          if (d[g, j] == "vfio-pci" || c[g, j] == "0604") continue
          if (v[g, j] == "10de" || (d[g, j] != "" && d[g, j] != "pci-stub")) ok = 0
        }
        if (!ok) printf "%s ", s[g, i]
      }
    }' <<<"$out")
  if [[ -n $blocked ]]; then
    check PF19 info "NVIDIA device(s) ${blocked% } not passable to VMs (their IOMMU group is not all on vfio-pci); the host takes only non-GPU VMs" "bind the whole IOMMU group to vfio-pci (docs/byoh/platforms/own-hardware.md)"
  else
    check PF19 pass "no NVIDIA device held by a host driver"
  fi
}

facts_network() {
  local addr route keys=() f
  addr=$(run_cmd ip-addr ip -j addr show)
  route=$(run_cmd ip-route ip -j -4 route show default)
  fact_json ip_addr "$addr"
  fact_json ip_route "$route"
  fact_str netplan "$(rd /etc/netplan/50-cloud-init.yaml)"

  for f in "$R"/etc/ssh/ssh_host_*_key.pub; do
    [[ -f $f ]] && keys+=("$(json_str "$(<"$f")")")
  done
  fact host_keys "[$(
    IFS=,
    echo "${keys[*]}"
  )]"

  local sshd
  sshd=$(run_root sshd-T sshd -T -C "user=root,addr=${CP_IP:-127.0.0.1}")
  fact sshd "{$(grep -Ei '^(permitrootlogin|authenticationmethods|allowusers|denyusers|pubkeyauthentication) ' <<<"$sshd" |
    while read -r k v; do printf '%s:%s,' "$(json_str "${k,,}")" "$(json_str "$v")"; done | sed 's/,$//')}"

  if ((STANDALONE)); then
    local count
    count=$(grep -o '"dst":"default"' <<<"$route" | wc -l)
    if ((count == 1)); then
      check default-route pass "one IPv4 default route"
    else
      check default-route fail "$count IPv4 default routes; the host needs exactly one uplink"
    fi
    if [[ -z $MAIN_IP ]]; then
      check main-ip-local info "no --main-ip given"
    elif grep -q "\"local\":\"$MAIN_IP\"" <<<"$addr"; then
      check main-ip-local pass "$MAIN_IP is on this host"
    else
      check main-ip-local warn "$MAIN_IP is not on this host; fine only when it is a NAT address in front of it"
    fi
  fi
}

