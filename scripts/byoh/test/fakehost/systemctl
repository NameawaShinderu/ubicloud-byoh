#!/bin/bash
# systemctl shim for the M4 fakehost, which has no systemd.
#   reload|restart ssh|ssh.service|sshd|sshd.service
#                  sends SIGHUP to the listening sshd (it re-execs and
#                  rereads its config, as `systemctl reload ssh` does)
#   is-active UNIT...
#                  "active" for each unit listed (space separated) in
#                  /etc/fakehost-active, else "inactive"; exits 0 only
#                  when all are active. The entrypoint writes that file
#                  from `docker run -e FAKEHOST_ACTIVE=...`, because an
#                  ssh session does not see the container's env.
#   anything else  exits 0 and does nothing
# Every call is appended to /var/log/fakehost-systemctl.log.
echo "$(id -un): systemctl $*" >>/var/log/fakehost-systemctl.log 2>/dev/null || true

args=()
quiet=0
for a in "$@"; do
  case $a in
    -q | --quiet) quiet=1 ;;
    -*) ;;
    *) args+=("$a") ;;
  esac
done
verb=${args[0]:-}

case $verb in
  reload | restart | reload-or-restart | try-reload-or-restart)
    case ${args[1]:-} in
      ssh | ssh.service | sshd | sshd.service)
        pid=$(cat /run/sshd.pid 2>/dev/null || echo 1)
        kill -HUP "$pid"
        ;;
    esac
    ;;
  is-active)
    rc=0
    read -r -a actives </etc/fakehost-active 2>/dev/null || true
    for unit in "${args[@]:1}"; do
      state=inactive
      for active in "${actives[@]}"; do
        [[ ${unit%.service} == "${active%.service}" ]] && state=active
      done
      [[ $state == active ]] || rc=3
      ((quiet)) || echo "$state"
    done
    exit "$rc"
    ;;
esac
exit 0
