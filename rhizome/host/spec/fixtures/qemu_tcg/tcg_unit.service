[Unit]
Description=vmtcg001
After=network.target

After=vmtcg001-0-storage.service
After=vmtcg001-dnsmasq.service

Requires=vmtcg001-0-storage.service
Wants=vmtcg001-dnsmasq.service

[Service]
Slice=system.slice
NetworkNamespacePath=/var/run/netns/vmtcg001
ExecStartPre=/usr/bin/rm -f /vm/vmtcg001/run/qmp.sock

ExecStart=qemu-system-x86_64 \
-name vmtcg001 \
-nodefaults \
-no-user-config \
-bios /usr/share/ovmf/OVMF.fd \
-object memory-backend-memfd,id=mem0,size=2G,share=on \
-numa node,memdev=mem0 \
-m 2G \
-smp cpus=2,maxcpus=2,threads=1,cores=2,dies=1,sockets=1 \
-cpu max,-svm,-vmx \
-machine q35 \
-accel tcg,thread=multi,tb-size=256 \
-chardev socket,id=vhostblk0,path=/var/storage/vmtcg001/0/vhost.sock,server=off \
-device vhost-user-blk-pci,chardev=vhostblk0,num-queues=2,queue-size=64,romfile= \
-drive if=none,file=/vm/vmtcg001/cloudinit.img,format=raw,readonly=on,id=cidrive \
-device virtio-blk-pci,drive=cidrive,romfile= \
-netdev tap,id=net0,ifname=nc5bn8tz4r0,script=no,downscript=no,queues=5,vhost=off \
-device virtio-net-pci,mac=52:54:00:12:34:56,netdev=net0,mq=on,romfile= \
-device virtio-rng-pci \
-serial file:/vm/vmtcg001/serial.log \
-display none \
-vga none \
-qmp unix:/vm/vmtcg001/run/qmp.sock,server=on,wait=off \
-sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny

KillSignal=SIGTERM
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/vm/vmtcg001
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service seccomp
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
UMask=0077
MemoryMax=2560M
TasksMax=4096

Restart=no
User=vmtcg001
Group=vmtcg001

LimitNOFILE=500000

CPUQuota=200%

