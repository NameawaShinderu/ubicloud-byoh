[Unit]
Description=vmgold01
After=network.target

After=vmgold01-0-storage.service
After=vmgold01-dnsmasq.service

Requires=vmgold01-0-storage.service
Wants=vmgold01-dnsmasq.service

[Service]
Slice=standard-gold.slice
NetworkNamespacePath=/var/run/netns/vmgold01
ExecStartPre=/usr/bin/rm -f /vm/vmgold01/ch-api.sock

ExecStart=/opt/cloud-hypervisor/v46.0/cloud-hypervisor -v \
--api-socket path=/vm/vmgold01/ch-api.sock \
--kernel /opt/fw/CLOUDHV-202311.fd \
--disk vhost_user=true,socket=/var/storage/vmgold01/0/vhost.sock,num_queues=2,queue_size=64 path=/var/storage/images/ai-model-test-20250101.raw,readonly=on path=/vm/vmgold01/cloudinit.img \
--console off --serial file=/vm/vmgold01/serial.log \
--cpus boot=4,topology=2:2:1:1 \
--memory size=4G,hugepages=on,hugepage_size=1G \
--net mac=52:54:00:12:34:56,tap=nc5bn8tz4r0,ip=,mask=,num_queues=9

Restart=no
User=vmgold01
Group=vmgold01

LimitNOFILE=500000

CPUQuota=400%

