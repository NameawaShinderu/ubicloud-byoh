# ==============================================================
#  terraform.tfvars.example
#  Copy to terraform.tfvars and edit for your deployment
# ==============================================================
# NOTE: terraform.tfvars is gitignored — never commit secrets or
# account-specific state. This .example file lives in git.

# Pick a region that doesn't overlap with your existing production
# infra. Default ap-south-1 is where the BYOH work was validated.
aws_region        = "ap-south-1"
availability_zone = "ap-south-1a"

# Tighten this to your public IP /32 for production testing.
# Leave 0.0.0.0/0 only if you really need SSH open to the world.
# operator_ssh_cidr = "203.0.113.42/32"
operator_ssh_cidr = "0.0.0.0/0"

# The VPC CIDR. Make sure this doesn't overlap with any existing
# VPC in your account. Default 10.99.0.0/16 is chosen to be unusual.
vpc_cidr    = "10.99.0.0/16"
subnet_cidr = "10.99.1.0/24"

# Control plane instance — any Ubuntu-compatible type works.
# t3.medium is cheap and has enough RAM for postgres + clover.
ctrl_plane_instance_type = "t3.medium"
ctrl_root_size_gb        = 40

# Data plane MUST be a bare-metal type (.metal suffix) for SPDK
# + cloud-hypervisor to work. Options in ap-south-1:
#   c5.metal     96 vCPU, 192 GB RAM, EBS-only storage
#   m5.metal     96 vCPU, 384 GB RAM, EBS-only storage
#   m5d.metal    96 vCPU, 384 GB RAM, 4×900 GB NVMe instance store (recommended)
#   r5d.metal    96 vCPU, 768 GB RAM, 4×900 GB NVMe instance store
#   c5n.metal    72 vCPU, 192 GB RAM, EBS-only, 100 Gbps network
#   i3en.metal   96 vCPU, 768 GB RAM, 8×7.5 TB NVMe (overkill)
#   m6id.metal  128 vCPU, 512 GB RAM, 4×1.4 TB NVMe (Ice Lake, newer)
data_plane_instance_type = "m5d.metal"
data_root_size_gb        = 120

# Pool of secondary private IPs. One EIP gets attached to each.
# Each slot = one concurrent publicly-reachable VM.
byoh_secondary_private_ips = [
  "10.99.1.128",
  "10.99.1.129",
  "10.99.1.130",
]
