[Unit]
Description=Ubicloud respirate (strand dispatcher)
PartOf=ubicloud.target
# Wants, not Requires: stopping or restarting postgres must not stop
# or restart the control plane along with it.
Wants=postgresql@16-main.service network-online.target
After=postgresql@16-main.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubicloud
Group=ubicloud
WorkingDirectory=/opt/ubicloud/current
EnvironmentFile=/etc/ubicloud/env
EnvironmentFile=/opt/ubicloud/current/.release-env
Environment=PATH=/opt/ubicloud/tools/bin:/usr/bin:/bin HOME=/var/lib/ubicloud
# bin/restarter exits 0 after RESTART_MINIMUM_TIME_ALIVE (an hour), so
# Restart=always is what keeps respirate running. A short pause keeps a
# respawn prompt.
Environment=RESTART_MAX_SLEEP=2
ExecStart=/opt/ubicloud/tools/bin/ruby bin/restarter bin/respirate
Restart=always
RestartSec=1
# TERM goes to bin/restarter only, which forwards it to respirate.
# respirate stops taking strands, gives running ones 2 s, then exits 1,
# though a strand thread inside a database query holds the exit until
# that query returns. When every dispatcher thread is busy, the scan
# thread cannot start the shutdown at all, and apoptosis ends respirate
# with status 2 up to 91 s after the oldest strand started. The stop
# timeout covers that before the SIGKILL; a strand interrupted by the
# SIGKILL runs again once its 120 s lease expires. The harness measures
# each case (scripts/byoh/test, restart scenario).
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=100
# Hardening. Every directive here was kept only after the container
# harness (scripts/byoh/test/run.sh) booted, logged in and ran strands
# with it. The release under /opt/ubicloud is read-only to the service;
# all writable state lives under /var/lib/ubicloud.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/ubicloud
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# 0007, not 0077: ubicloud-migrate (group ubicloud) runs migrations
# and restores, which rewrite var/ca_bundles under the same lock files.
UMask=0007
