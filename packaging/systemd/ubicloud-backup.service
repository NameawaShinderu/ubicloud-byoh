[Unit]
Description=Ubicloud backup (database and encrypted secrets)
# Not PartOf=ubicloud.target, unlike the timer: stopping or restarting
# the target must not kill a backup halfway through its dump, or start
# it over. ubicloud-admin's lock keeps a backup apart from a restore.
# Until ubicloud-admin is installed (WP6), a timer run is skipped rather
# than failed, so the system does not go degraded at 03:15.
ConditionFileIsExecutable=/usr/local/bin/ubicloud-admin
Wants=postgresql@16-main.service
After=postgresql@16-main.service

[Service]
Type=oneshot
# Runs as root: ubicloud-admin takes its lock, dumps as postgres and
# encrypts /etc/ubicloud with the operator's age recipient.
ExecStart=/usr/local/bin/ubicloud-admin backup now
UMask=0077
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
