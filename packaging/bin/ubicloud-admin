#!/bin/bash
# Operates a control plane that scripts/byoh/install.sh installed. Run it
# as root (sudo); install.sh puts it in /usr/local/bin.
#
#   ubicloud-admin status
#   ubicloud-admin smoke
#   ubicloud-admin backup now|list|prune --keep N
#   ubicloud-admin restore TS --key-file F [--env-only|--db-only] [--force] [--no-start]
#   ubicloud-admin env set KEY [--no-restart]   (the value on stdin, or typed)
#   ubicloud-admin env unset KEY [--no-restart]
#   ubicloud-admin env get KEY --reveal
#   ubicloud-admin env keys
#   ubicloud-admin logs [web|respirate|monitor|backup|caddy|cloudflared]... [-f] [--since T] [-n N]
#   ubicloud-admin account create --email E [--name N] [--project P] [--password-stdin|--password-file F]
#   ubicloud-admin account list
#   ubicloud-admin [--dev] site add NAME [--display TEXT] [--rates-from LOC] [--grant PROJECT]... [profile options]
#   ubicloud-admin [--dev] site list|show|set|rates|grant|revoke|delete [NAME] [OPTIONS]
#   ubicloud-admin [--dev] host add --site NAME --ssh USER@HOST [--ssh-key F] (--pool-file F | --routed-network CIDR ...) [--virt-tier T [--accept-fallback] [--install-pvm-kernel]]
#   ubicloud-admin [--dev] host preflight|watch|move-location|setup-egress-nat|export-audit|relearn-device-ids|relearn-pci ...
#   ubicloud-admin [--dev] pool list|export|add|remove|remap|annotate|ipv6|verify|trace ...
#   ubicloud-admin run TOOL [ARGS...]
#   ubicloud-admin console [-e CODE|-e -]
#   ubicloud-admin release list
#   ubicloud-admin release check VERSION
#   ubicloud-admin release migrate VERSION [--skip-backup-check]
#   ubicloud-admin release use VERSION [--for-restore TS]
#   ubicloud-admin release prune --keep N
#
# status   Units, settings (bin/byoh-config-check), pg_hba trust rules,
#          backup recipient and age, release. Exits 1 on any fail.
# smoke    What install.sh runs last (step 12): puma answers on its
#          address; the front in /etc/ubicloud/front.conf runs (caddy,
#          or the cloudflared unit) and answers (caddy on 127.0.0.1:443
#          under the BASE_URL host for acme and provided, BASE_URL itself
#          for tunnel); web and respirate are active; bin/byoh-config-check
#          has no fail; and with RACK_ENV=production, bin/production_check
#          passes (it needs port 8081, so PORT must not be 8081). Only what
#          comes up in the background warns: an acme certificate caddy
#          has not got yet (TLS handshake failure), and a tunnel not yet
#          connected (no answer, or Cloudflare's 530). Exits 1 on any
#          fail. It changes no setting and no unit, but the two checks
#          boot the app as ubicloud, which rewrites
#          /var/lib/ubicloud/var/ca_bundles.
# backup   now: <target>/<UTC timestamp>/ with db.dump (pg_dump -Fc),
#          globals.sql, billing-rates.tar and manifest.json, and
#          <target>/secrets/<timestamp>.age, a tar of /etc/ubicloud
#          encrypted to the recipients in /etc/ubicloud/backup-recipients
#          (skipped, with a warning, when there are none). prune keeps the
#          newest N and never touches other directories (pre-migration-*).
#          The target is BACKUP_TARGET in /etc/ubicloud/backup.conf.
# restore  Checks the backup (sha256, pg_restore --list, no migration the
#          release lacks, no extension but citext and btree_gist) and
#          restores it into database ubicloud_restore as role
#          ubicloud_restorer, never as a superuser. Only then does it stop
#          the services and swap the databases: ubicloud becomes
#          ubicloud_prev_<time> (kept; drop it yourself) and
#          ubicloud_restore becomes ubicloud. It migrates, then installs
#          the TLS files, tunnel token, backup settings and billing rates
#          of the backup, starts the services and prints status.
#          --no-start leaves the services stopped, so the restored
#          respirate never runs the backup's strands (the restore drill
#          on a disposable machine); it does not apply to --env-only. If
#          anything fails after the swap, the old database, /etc/ubicloud
#          and the billing rates are put back. The env file is replaced
#          only when it is missing or with --force (the old one is kept as
#          /etc/ubicloud/env.before-restore-<time>, also with --env-only),
#          and a backup made with another CLOVER_COLUMN_ENCRYPTION_KEY
#          needs --force. --db-only needs no --key-file: it keeps the env
#          file, whose column key must match the backup's. On a new
#          machine, run install.sh, copy the backups into the target, then
#          restore TS --key-file F --force.
#          A backup is trusted: its sha256s catch damage, not tampering,
#          and anyone with the recipient can write a secrets file. Keep
#          the backups where only root can write them.
# env      Changes /etc/ubicloud/env and restarts the services. Values are
#          never printed, except by env get --reveal. If web does not
#          answer after the restart, the old file is put back. Keys that
#          install.sh owns through a flag (BASE_URL, RACK_ENV, MAIL_*,
#          SMTP_*, IP_FROM_HEADER), the secrets and keys that load code
#          into Ruby (RUBYOPT, GEM_*, BUNDLE_*, ...) are refused.
# run      TOOL is byoh-location, byoh-pool, byoh-host, register-byoh-host, byoh-virt,
#          byoh-config-check, production_check, create_prod_admin_account
#          (bin/rake-task-runner) or m2-checks (scripts/byoh/verify, the
#          database checks of the M2 and M4 gates). It runs in the release
#          as user ubicloud; the files named by --pool-file, --ssh-key,
#          --registration-key, --external-map, --password-file and
#          --snapshot are copied for it, and --out FILE is written
#          back. --bmc-password is refused: put the password in the env
#          file (env set BMC_PASS) and pass --bmc-pass-env BMC_PASS.
# site     bin/byoh-location: the location (site) of BYOH hosts, its
#          network profile, billing rates and grants. site add NAME is
#          create --name NAME; --display TEXT is the name customers see
#          (--display-name stays the API path name); --mgmt takes only
#          direct and --postgres only no until M8 and ROADMAP §8.2.
#          After site add or site rates changed a file in
#          /var/lib/ubicloud/billing_rates.d, it restarts ubicloud.target
#          (when it runs) and waits for web, so the services load the
#          rates. site set restarts nothing.
# host     bin/byoh-host. host add runs the tool twice: --phase prepare
#          with the staged copies of --ssh-key and --registration-key,
#          which it then deletes, and --phase register without them, so
#          the operator's key is gone before the watch of the bring-up
#          (hours) starts. An explicit --phase runs once, as given.
# pool     bin/byoh-pool.
#          site, host and pool run like run (the files are copied for
#          user ubicloud, --bmc-password is refused) and pass --help to
#          the tool. They do not take /run/ubicloud-admin.lock, except for
#          the restart. UBICLOUD_ADMIN_DRYRUN=1 prints the command lines
#          they would run and runs nothing.
# --dev    (or UBICLOUD_ADMIN_DEV=1) For site, host and pool only: runs
#          the tools of the development checkout this script is in
#          (scripts/byoh/bootstrap-dev-ctrl-plane.sh), with bundle exec, as
#          the invoking user, or as SUDO_USER under sudo, with
#          ~/.local/bin and the mise Ruby of mise.toml on PATH. Refused
#          when /etc/ubicloud or /opt/ubicloud exists. It restarts
#          nothing: restart puma and respirate yourself after a rates
#          change. As root without SUDO_USER, it prints the command to
#          run as the checkout's owner and exits 2.
# console  bin/pry, or the code of -e run through bin/pry, as user
#          ubicloud. With PRY_AUDIT_BUCKET or OTEL_EXPORTER_OTLP_ENDPOINT
#          in the env file, bin/pry sends the session and the code of -e
#          to that sink. Without one, it runs with PRY_ALLOW_UNAUDITED=true
#          for this session only: one line goes to the system log (who and
#          when), and the commands themselves are NOT audited. -e CODE is
#          on sudo's command line, which sudo logs; -e - reads the code
#          from stdin instead.
# release  The manual release switch (docs/byoh/OPERATIONS.md, release
#          switch); install.sh --stage release builds VERSION next to the
#          current one. list shows the releases, which is current and
#          previous, and how each stands to the database's migrations.
#          check VERSION says, changing nothing, whether migrate and use
#          would take VERSION. migrate VERSION runs the migrations of
#          VERSION as ubicloud-migrate, from its directory. use VERSION
#          installs its units and ubicloud-admin and points current at it
#          (the old one becomes previous). Both refuse while web,
#          respirate or monitor run (systemctl stop ubicloud.target
#          ubicloud-web ubicloud-respirate ubicloud-monitor first), and
#          refuse a release that runs other tools than
#          /opt/ubicloud/tools or that is not root's alone. migrate refuses
#          unless a backup made after the services last ran (backup now
#          after the stop) holds the database, or holds it as it was
#          before migrations of VERSION that an earlier migrate run
#          applied, and current can restore it; --skip-backup-check
#          skips this. use refuses a release that lacks a migration the
#          database has applied (a downgrade onto a newer schema) or that
#          has migrations not applied yet (migrate first). --for-restore
#          TS takes such a downgrade when backup TS holds only migrations
#          VERSION knows, and holds web, respirate, monitor and the
#          backup timer's runs (systemd drop-ins, also across a reboot)
#          until restore TS --db-only swapped the database. prune removes
#          all but the N newest releases, never current or previous.
#          Starting the services is left to the operator; ubicloud-admin
#          upgrade comes with M12.
#
# Every command except logs and env keys writes one line with the command
# name and $SUDO_USER, never its arguments, to the system log (tag
# ubicloud-admin). backup, restore and env changes hold
# /run/ubicloud-admin.lock, the lock install.sh takes.
#
# Exit status: 0 on success, 1 on a failure, 2 on a usage error or a
# refusal that changed nothing.
#
# Docs: docs/byoh/OPERATIONS.md.
set -euo pipefail
umask 077

readonly OPT=/opt/ubicloud
readonly TOOLS=$OPT/tools
readonly CURRENT=$OPT/current
readonly RELEASES=$OPT/releases
readonly PREVIOUS=$OPT/previous
readonly UNIT_DIR=/etc/systemd/system
readonly ADMIN_BIN=/usr/local/bin/ubicloud-admin
readonly VERSION_RE='^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$'
readonly STATE=/var/lib/ubicloud
readonly ETC=/etc/ubicloud
readonly ENV_FILE=$ETC/env
readonly BACKUP_CONF=$ETC/backup.conf
readonly BACKUP_RECIPIENTS=$ETC/backup-recipients
readonly FRONT_CONF=$ETC/front.conf
# bin/production_check's puma.
readonly CHECK_PORT=8081
readonly LOCK=/run/ubicloud-admin.lock
readonly PG_UNIT=postgresql@16-main
readonly SERVICE_PATH=$TOOLS/bin:/usr/bin:/bin
readonly DB_NAME=ubicloud
readonly TS_RE='^[0-9]{8}T[0-9]{6}Z$'
# The units status checks and restore stops and starts.
readonly SERVICES=(ubicloud-web ubicloud-respirate ubicloud-monitor)
# release use --for-restore: while this file exists, drop-ins keep the
# services (and the backup timer's runs) from starting on a schema
# current does not know.
readonly HOLD=$STATE/release-hold
readonly HOLD_DROPIN=50-ubicloud-release-hold.conf

# Keys the env file must never set (the same lists as install.sh).
readonly KEY_RE='^[A-Z][A-Z0-9_]{0,63}$'
readonly DENIED_KEY_RE='^(PATH|IFS|BASH_ENV|ENV|HOME|SHELL|LD_[A-Z0-9_]*)$'
# Keys that load code into Ruby, bundler or node: env set refuses them
# and a restore refuses an env file that sets one.
readonly INTERP_KEY_RE='^(RUBYOPT|RUBYLIB|RUBYSHELL|GEM_[A-Z0-9_]*|BUNDLE_[A-Z0-9_]*|BUNDLER_[A-Z0-9_]*|NODE_OPTIONS|NODE_PATH)$'

# --- output ---------------------------------------------------------------

FAILS=0 WARNS=0
report() { printf '%-7s %s\n' "$1" "$2"; }
fail_line() {
  report fail "$1"
  FAILS=$((FAILS + 1))
}
warn_line() {
  report warn "$1"
  WARNS=$((WARNS + 1))
}
die() {
  printf 'ubicloud-admin: %s\n' "$1" >&2
  exit "${2:-1}"
}
usage_die() { die "$1" 2; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

# audit NAME: one line in the system log, never the arguments.
audit() {
  logger -t ubicloud-admin -p auth.notice -- "$1 by ${SUDO_USER:-root} (uid ${SUDO_UID:-0})" 2>/dev/null || true
}

WORK=""
# Other temporary directories, removed with WORK.
CLEAN_PATHS=()
cleanup_work() {
  [[ -z $WORK ]] || rm -rf "$WORK"
  ((${#CLEAN_PATHS[@]} == 0)) || rm -rf "${CLEAN_PATHS[@]}"
}
make_work() {
  [[ -n $WORK ]] && return 0
  WORK=$(mktemp -d /tmp/ubicloud-admin.XXXXXX)
  trap cleanup_work EXIT
}

# take_lock SECONDS: the lock install.sh and every changing command take.
take_lock() {
  exec 9>>"$LOCK"
  if ! flock -n 9; then
    printf 'ubicloud-admin: waiting for %s (another install.sh or ubicloud-admin run holds it)\n' "$LOCK" >&2
    flock -w "$1" 9 || die "another install.sh or ubicloud-admin run still holds $LOCK after $1 s"
  fi
}

need_root() { [[ $EUID == 0 ]] || die "run ubicloud-admin as root (sudo ubicloud-admin ...)"; }
need_release() { [[ -d $CURRENT/ && -f $ENV_FILE ]] || die "no control plane here: $CURRENT or $ENV_FILE is missing (install with scripts/byoh/install.sh)"; }

# --- the KEY='value' file format (M3-b), as in install.sh -------------------

declare -A KV=()
KV_KEYS=()
KV_LINES=()

# kv_read FILE: loads FILE into KV, KV_KEYS (in file order) and KV_LINES
# (every line, comments included). Errors name the line, never a value.
kv_read() {
  local file=$1 line n=0 re="^([A-Z][A-Z0-9_]{0,63})='([^']*)'$"
  KV=() KV_KEYS=() KV_LINES=()
  [[ -e $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    KV_LINES+=("$line")
    [[ -z $line || $line == \#* ]] && continue
    [[ $line =~ $re ]] || die "$file line $n is not KEY='value' (the value is not shown)"
    local key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    [[ ! $key =~ $DENIED_KEY_RE ]] || die "$file line $n sets $key, which the env file must not set"
    [[ $value != *\\* && $value != *$'\r'* ]] || die "$file line $n: the value of $key has a backslash or CR"
    [[ -z ${KV[$key]+x} ]] || die "$file line $n sets $key a second time"
    KV[$key]=$value
    KV_KEYS+=("$key")
  done <"$file"
}

valid_value() { [[ $1 != *"'"* && $1 != *\\* && $1 != *$'\n'* && $1 != *$'\r'* ]]; }

# env_value KEY [DEFAULT]: KEY from the env file.
env_value() {
  kv_read "$ENV_FILE"
  printf '%s' "${KV[$1]:-${2:-}}"
}

backup_target() {
  kv_read "$BACKUP_CONF"
  local t=${KV[BACKUP_TARGET]:-/var/backups/ubicloud}
  [[ $t == /* && $t != s3://* ]] || die "BACKUP_TARGET in $BACKUP_CONF must be an absolute directory (s3:// comes with E5)"
  printf '%s' "${t%/}"
}

# secure_state: makes $STATE root:ubicloud 0750, as install.sh does
# (older layouts had it owned by ubicloud, which could then swap its
# entries for symlinks root follows), and refuses a var/,
# billing_rates.d/ or byoh-keys/ that is not a real directory.
secure_state() {
  [[ ! -L $STATE ]] || die "$STATE is a symlink; it must be a directory"
  install -d -m 0750 -o root -g ubicloud "$STATE"
  local d
  for d in "$STATE/var" "$STATE/billing_rates.d" "$STATE/byoh-keys"; do
    [[ ! -L $d && (! -e $d || -d $d) ]] ||
      die "$d is a symlink or not a directory; a process of user ubicloud may have replaced it. Inspect it and move it away"
  done
}

# --- running code of the release ----------------------------------------------

# Extra NAME=value pairs for the next as_service, after the env file.
SERVICE_EXTRA=()
SERVICE_HOME=$STATE
# The release as_service runs in: current, except for release migrate.
SERVICE_RELEASE=$CURRENT

# as_service USER CMD...: runs CMD in SERVICE_RELEASE as USER with
# exactly the env file, the release env, SERVICE_EXTRA, PATH, HOME and
# LANG=C.UTF-8, umask 0007, as the units run. The values travel in the environment,
# never in argv, and setpriv execs CMD without a PAM session.
as_service() {
  local user=$1 group
  shift
  group=$(id -gn "$user")
  (
    cd "$SERVICE_RELEASE" || exit 1
    local k f x
    while IFS= read -r k; do unset "$k" 2>/dev/null || exit 1; done < <(compgen -e)
    # Unlike the units, these commands print to a terminal: puma's and
    # pry's output is UTF-8, which Ruby rejects under the C locale. The
    # env file may still set LANG.
    export LANG=C.UTF-8
    for f in "$ENV_FILE" "$SERVICE_RELEASE/.release-env"; do
      kv_read "$f"
      for k in "${KV_KEYS[@]}"; do
        export "$k=${KV[$k]}" 2>/dev/null || die "$f sets $k, which bash cannot export"
      done
    done
    for x in "${SERVICE_EXTRA[@]}"; do export "${x?}"; done
    # Only in this subshell; the dev layout reads the caller's values.
    # shellcheck disable=SC2030
    export PATH=$SERVICE_PATH HOME=$SERVICE_HOME
    umask 0007
    # fd 9 is the lock of install.sh or ubicloud-admin, which no
    # unprivileged process may hold.
    exec setpriv --reuid="$user" --regid="$group" --init-groups -- "$@" 9>&-
  )
}

ruby_as() {
  local user=$1
  shift
  as_service "$user" "$TOOLS/bin/ruby" "$@"
}

# --- postgres -----------------------------------------------------------------

psql_value() { runuser -u postgres -- psql -X -tA -v ON_ERROR_STOP=1 "$@"; }
psql_admin() { runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 "$@"; }
db_exists() { [[ -n $(psql_value -d postgres -c "SELECT 1 FROM pg_database WHERE datname = '$1'") ]]; }

# --- status ---------------------------------------------------------------------

unit_state() { systemctl is-active "$1" 2>/dev/null || true; }

cmd_status() {
  [[ $# -eq 0 ]] || usage_die "status takes no arguments"
  need_root
  need_release
  audit status
  FAILS=0 WARNS=0
  local u s
  for u in ubicloud.target ubicloud-web ubicloud-respirate ubicloud-backup.timer "$PG_UNIT"; do
    s=$(unit_state "$u")
    if [[ $s == active ]]; then report ok "unit: $u active"; else fail_line "unit: $u $s (ubicloud-admin logs)"; fi
  done
  if [[ $(systemctl is-enabled ubicloud.target 2>/dev/null || true) != enabled ]]; then
    fail_line "unit: ubicloud.target is not enabled, so nothing starts at boot (systemctl enable ubicloud.target)"
  fi
  if [[ $(systemctl is-enabled ubicloud-monitor 2>/dev/null || true) == enabled ]]; then
    warn_line "unit: ubicloud-monitor is enabled; host health checks are meant to start with M9"
  else
    report ok "unit: ubicloud-monitor disabled (expected until M9)"
  fi
  [[ $(systemctl is-failed ubicloud-backup.service 2>/dev/null || true) != failed ]] ||
    fail_line "unit: the last ubicloud-backup run failed (ubicloud-admin logs backup)"

  local rel
  rel=$(readlink "$CURRENT" 2>/dev/null || true)
  if [[ -f $CURRENT/.ubicloud-release ]]; then
    report ok "release: ${rel##*/} rev $(sed -n 's/^rev=//p' "$CURRENT/.ubicloud-release")"
  else
    fail_line "release: $CURRENT has no .ubicloud-release"
  fi
  status_release

  local code
  code=$(web_code)
  if [[ $code =~ ^[1-5][0-9][0-9]$ ]]; then report ok "web: answers on $(web_addr) (HTTP $code)"; else fail_line "web: no answer on $(web_addr)"; fi

  status_env
  status_postgres
  status_backups

  # The settings and database checks of the release (bin/byoh-config-check).
  local out rc=0
  out=$(ruby_as ubicloud bin/byoh-config-check 2>&1) || rc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  WARNS=$((WARNS + $(grep -c '^warn' <<<"$out" || true)))
  if ((rc)); then fail_line "config: bin/byoh-config-check reports failures (above)"; else report ok "config: bin/byoh-config-check has no fail"; fi

  echo
  if ((FAILS)); then
    echo "status: $FAILS fail, $WARNS warn"
    return 1
  fi
  echo "status: ok ($WARNS warn)"
}

# Where puma listens, as host:port for curl.
web_addr() {
  local port bind
  port=$(env_value PORT 3000)
  bind=$(env_value BIND 127.0.0.1)
  [[ $bind == 0.0.0.0 || $bind == "::" ]] && bind=127.0.0.1
  [[ $bind != *:* ]] || bind="[$bind]"
  printf '%s:%s' "$bind" "$port"
}

# The HTTP status of puma's front page, or 000.
web_code() { curl -s -o /dev/null -m 10 -w '%{http_code}' "http://$(web_addr)/" 2>/dev/null || true; }

# wait_web SECONDS: waits for puma to answer after a start.
wait_web() {
  local i
  for ((i = 0; i < $1; i++)); do
    [[ $(web_code) =~ ^[1-5][0-9][0-9]$ ]] && return 0
    sleep 1
  done
  return 1
}

status_env() {
  local mode
  mode=$(stat -c '%U:%G %a' "$ENV_FILE")
  if [[ $mode == "root:root 600" ]]; then report ok "env: $ENV_FILE root 0600"; else fail_line "env: $ENV_FILE is $mode, not root:root 600"; fi
  kv_read "$ENV_FILE"
  # M3-q: the console sets it for one session; the services never may.
  if [[ -n ${KV[PRY_ALLOW_UNAUDITED]+x} ]]; then
    fail_line "env: $ENV_FILE sets PRY_ALLOW_UNAUDITED, which lets bin/pry run unaudited from every service; remove it (ubicloud-admin env unset PRY_ALLOW_UNAUDITED)"
  fi
  [[ -n ${KV[CLOVER_COLUMN_ENCRYPTION_KEY]:-} ]] || fail_line "env: $ENV_FILE has no CLOVER_COLUMN_ENCRYPTION_KEY"
}

status_postgres() {
  local lines supers
  # A trust rule that can match database ubicloud lets any local user in
  # without a password. The managed block rejects such logins first, but
  # a trust rule also reaches superusers, and a superuser reaches ubicloud.
  lines=$(psql_value -d postgres -c "SELECT string_agg(line_number::text, ',' ORDER BY line_number) FROM pg_hba_file_rules WHERE auth_method = 'trust' AND database && ARRAY['ubicloud', 'all', 'sameuser', 'samerole']") ||
    { fail_line "postgres: cannot read pg_hba_file_rules"; return; }
  if [[ -n $lines ]]; then
    fail_line "postgres: pg_hba.conf line(s) $lines use trust for database ubicloud or all; on a control plane moved from the development bootstrap this is expected until migrate-from-dev.sh retire (docs/byoh/MIGRATE_FROM_DEV.md)"
  else
    report ok "postgres: no trust rule for database ubicloud"
  fi
  supers=$(psql_value -d postgres -c "SELECT string_agg(rolname, ',' ORDER BY rolname) FROM pg_roles WHERE rolsuper AND rolcanlogin AND rolname <> 'postgres'")
  [[ -z $supers ]] || warn_line "postgres: role(s) $supers are superusers that can log in; a superuser can reach ubicloud"
  local kept
  kept=$(psql_value -d postgres -c "SELECT string_agg(datname, ' ' ORDER BY datname) FROM pg_database WHERE datname ~ '^ubicloud_(prev|failed|restore)'")
  [[ -z $kept ]] || warn_line "postgres: database(s) $kept are left from restores and use disk; drop each once it is not needed (runuser -u postgres -- dropdb NAME)"
}

# The complete backups, newest first: <timestamp> directories with a
# manifest.
backups_newest_first() {
  local target=$1 d
  for d in $(find "$target" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | grep -E "$TS_RE" | sort -r); do
    [[ ! -f $target/$d/manifest.json ]] || echo "$d"
  done
}

# The newest complete backup. No head: under pipefail its early exit
# could fail the pipe with SIGPIPE.
latest_backup() {
  local all
  all=$(backups_newest_first "$1")
  printf '%s' "${all%%$'\n'*}"
}

ts_epoch() { date -u -d "$(sed -E 's/^(....)(..)(..)T(..)(..)(..)Z$/\1-\2-\3 \4:\5:\6/' <<<"$1")" +%s; }

status_backups() {
  local target last age hours
  target=$(backup_target)
  if [[ -s $BACKUP_RECIPIENTS ]] && grep -q '^age1' "$BACKUP_RECIPIENTS"; then
    report ok "backup: secrets are encrypted to $(grep -c '^age1' "$BACKUP_RECIPIENTS") recipient(s) in $BACKUP_RECIPIENTS"
  else
    fail_line "backup: no recipient in $BACKUP_RECIPIENTS, so the secrets in $ETC (the column key) are not backed up; run install.sh with --backup-recipient age1... --update-env BACKUP_RECIPIENTS"
  fi
  last=$(latest_backup "$target")
  if [[ -n $last ]]; then
    age=$(($(date +%s) - $(ts_epoch "$last")))
  elif [[ -e $BACKUP_CONF ]]; then
    # No backup yet: judged by how long the install has been without one.
    age=$(($(date +%s) - $(stat -c %Y "$BACKUP_CONF")))
  else
    age=0
  fi
  hours=$((age / 3600))
  local what="no backup in $target for ${hours} h"
  [[ -z $last ]] || what="the last backup ($last) is ${hours} h old"
  if ((age > 72 * 3600)); then
    fail_line "backup: $what (ubicloud-admin logs backup)"
  elif ((age > 36 * 3600)); then
    warn_line "backup: $what"
  elif [[ -n $last ]]; then
    report ok "backup: last $last (${hours} h ago) in $target"
  else
    report ok "backup: none yet in $target (the timer runs daily at 03:15; ubicloud-admin backup now)"
  fi
}

# --- smoke (install.sh step 12) ---------------------------------------------------

# probe SECONDS URL [CURL_OPTION...]: GETs URL until it answers 2xx or
# 3xx or SECONDS pass. Sets PROBE_CODE (000 without an HTTP answer) and
# PROBE_RC (curl's exit status).
probe() {
  local end=$((SECONDS + $1)) url=$2
  shift 2
  while :; do
    PROBE_RC=0
    PROBE_CODE=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "$@" "$url" 2>/dev/null) || PROBE_RC=$?
    PROBE_CODE=${PROBE_CODE:-000}
    [[ $PROBE_CODE =~ ^[23][0-9][0-9]$ ]] && return 0
    # 6: the host name does not resolve, which waiting does not change.
    ((PROBE_RC == 6 || SECONDS >= end)) && return 1
    sleep 1
  done
}

# front_unit FRONT: the unit that serves FRONT (none for none): caddy for
# acme and provided; for tunnel install.sh's ubicloud-cloudflared, or the
# cloudflared.service it left as it was.
front_unit() {
  case $1 in
    acme | provided) echo caddy.service ;;
    tunnel)
      if [[ -e /etc/systemd/system/ubicloud-cloudflared.service ]]; then
        echo ubicloud-cloudflared.service
      else
        echo cloudflared.service
      fi
      ;;
  esac
}

# settled_state UNIT: its state once it is active or 10 s pass.
settled_state() {
  local i
  for i in $(seq 10); do
    [[ $(unit_state "$1") != active ]] || break
    sleep 1
  done
  unit_state "$1"
}

# The front through which the smoke GET goes: TLS_FRONT in front.conf,
# which install.sh writes once the front runs (none before that). Its
# unit must run first: a front that is down fails, whatever curl says.
# Only what comes up in the background warns: an acme certificate that
# caddy has not got yet (the TLS handshake fails, curl exit 35), and a
# tunnel that has not connected (activating, no answer, or Cloudflare's
# 530 for a tunnel without a connector).
smoke_front() {
  local front base host unit state
  kv_read "$FRONT_CONF"
  front=${KV[TLS_FRONT]:-none}
  base=$(env_value BASE_URL)
  base=${base%/}
  case $front in
    none) return ;;
    acme | provided | tunnel) ;;
    *)
      fail_line "smoke: $FRONT_CONF names an unknown front $front"
      return
      ;;
  esac
  unit=$(front_unit "$front")
  state=$(settled_state "$unit")
  case $state in
    active) report ok "smoke: $unit active" ;;
    activating | reloading)
      if [[ $front == tunnel ]]; then
        warn_line "smoke: $unit is $state; cloudflared connects in the background (ubicloud-admin logs cloudflared)"
      else
        fail_line "smoke: $unit is still $state after 10 s (ubicloud-admin logs caddy)"
        return
      fi
      ;;
    *)
      local logs=caddy
      [[ $front != tunnel ]] || logs=cloudflared
      fail_line "smoke: $unit is ${state:-unknown}, so nothing serves $base (systemctl start $unit; ubicloud-admin logs $logs)"
      return
      ;;
  esac
  case $front in
    acme | provided)
      if [[ ! $base =~ ^https://([A-Za-z0-9.-]+)$ ]]; then
        fail_line "smoke: front --tls $front, but BASE_URL is not https://HOST"
        return
      fi
      host=${BASH_REMATCH[1]}
      # The certificate is not what is tested here (install.sh checks a
      # provided one), so -k; --resolve sends the request to this
      # machine's caddy under the name it serves.
      if probe 30 "https://$host/login" -k --resolve "$host:443:127.0.0.1"; then
        report ok "smoke: caddy serves https://$host (HTTP $PROBE_CODE)"
      elif [[ $front == acme && $PROBE_CODE == 000 && $PROBE_RC == 35 ]]; then
        warn_line "smoke: caddy has no certificate for $host yet (curl exit 35, TLS handshake); it gets one from Let's Encrypt in the background, which needs public DNS and ports 80 and 443 (ubicloud-admin logs caddy)"
      else
        fail_line "smoke: https://$host through caddy on 127.0.0.1:443 answers HTTP $PROBE_CODE (curl exit $PROBE_RC; ubicloud-admin logs caddy web)"
      fi
      ;;
    tunnel)
      if probe 30 "$base/login"; then
        report ok "smoke: $base answers through the tunnel (HTTP $PROBE_CODE)"
      elif [[ $PROBE_CODE == 000 || $PROBE_CODE == 530 ]]; then
        # cloudflared connects in the background (Cloudflare answers 530
        # until it has), and the public name may not resolve from this
        # machine.
        warn_line "smoke: no answer from $base yet (HTTP $PROBE_CODE, curl exit $PROBE_RC); the tunnel connects in the background, and its public hostname must route to http://$(web_addr) (ubicloud-admin logs cloudflared)"
      else
        fail_line "smoke: $base answers HTTP $PROBE_CODE through the tunnel; check that its public hostname routes to http://$(web_addr) (ubicloud-admin logs cloudflared web)"
      fi
      ;;
  esac
}

# bin/production_check boots a second puma with RACK_ENV=production on
# port 8081 and expects a 401 for a JSON login POST to localhost:8081.
# BIND=127.0.0.1 keeps that puma on loopback whatever BIND the env file
# sets. Where localhost resolves to ::1 first (as in docker's
# /etc/hosts), Ruby's Net::HTTP falls back to 127.0.0.1 (scripts/byoh/
# test, fresh), so bin/production_check stays as upstream wrote it.
smoke_production_check() {
  if [[ $(env_value RACK_ENV) != production ]]; then
    report skip "smoke: bin/production_check (RACK_ENV is $(env_value RACK_ENV development), not production)"
    return
  fi
  if [[ $(env_value PORT 3000) == "$CHECK_PORT" ]]; then
    fail_line "smoke: PORT is $CHECK_PORT, which bin/production_check needs for its own puma; move puma to another port (ubicloud-admin env set PORT)"
    return
  fi
  if [[ -n $(ss -Htln "sport = :$CHECK_PORT") ]]; then
    fail_line "smoke: port $CHECK_PORT is taken, so bin/production_check cannot start its puma (ss -tlnp 'sport = :$CHECK_PORT')"
    return
  fi
  make_work
  SERVICE_EXTRA=(BIND=127.0.0.1)
  if ruby_as ubicloud bin/production_check >"$WORK/production_check.log" 2>&1; then
    report ok "smoke: bin/production_check (a production puma boots and answers a login with 401)"
  else
    tail -20 "$WORK/production_check.log" | sed 's/^/  /'
    fail_line "smoke: bin/production_check failed (above)"
  fi
  SERVICE_EXTRA=()
}

cmd_smoke() {
  [[ $# -eq 0 ]] || usage_die "smoke takes no arguments"
  need_root
  need_release
  audit smoke
  FAILS=0 WARNS=0
  # puma itself, which a restart may have just started.
  if probe 120 "http://$(web_addr)/login"; then
    report ok "smoke: puma answers on $(web_addr) (HTTP $PROBE_CODE)"
  else
    fail_line "smoke: puma does not answer on $(web_addr) (HTTP $PROBE_CODE)"
  fi
  smoke_front
  local u state
  for u in ubicloud-web ubicloud-respirate; do
    state=$(settled_state "$u")
    if [[ $state == active ]]; then report ok "smoke: $u active"; else fail_line "smoke: $u is $state"; fi
  done
  local out rc=0
  out=$(ruby_as ubicloud bin/byoh-config-check 2>&1) || rc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  WARNS=$((WARNS + $(grep -c '^warn' <<<"$out" || true)))
  if ((rc)); then fail_line "smoke: bin/byoh-config-check reports failures (above)"; else report ok "smoke: bin/byoh-config-check has no fail"; fi
  smoke_production_check
  if ((FAILS)); then
    echo "smoke: $FAILS fail, $WARNS warn; see ubicloud-admin logs web respirate"
    return 1
  fi
  echo "smoke: ok ($WARNS warn)"
}

# --- backup -------------------------------------------------------------------------

cmd_backup() {
  local sub=${1:-}
  shift || true
  case $sub in
    now) backup_now "$@" ;;
    list) backup_list "$@" ;;
    prune) backup_prune "$@" ;;
    *) usage_die "backup takes now, list or prune --keep N" ;;
  esac
}

sha_of() { sha256sum "$1" | cut -d' ' -f1; }

# The column key's fingerprint, so a restore can tell whether an env
# file belongs to a backup without decrypting either.
key_fingerprint() { printf 'ubicloud-column-key:%s' "$1" | sha256sum | cut -d' ' -f1; }

backup_now() {
  [[ $# -eq 0 ]] || usage_die "backup now takes no arguments"
  need_root
  need_release
  audit "backup now"
  local target ts dir partial
  target=$(backup_target)
  # A timer run waits for an install or restore to finish.
  take_lock 7200
  make_work
  install -d -m 0700 -o root -g root "$target" "$target/secrets"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  while [[ -e $target/$ts ]]; do
    sleep 1
    ts=$(date -u +%Y%m%dT%H%M%SZ)
  done
  dir=$target/$ts
  partial=$target/.$ts.partial
  rm -rf "$partial"
  install -d -m 0700 "$partial"
  trap 'rm -rf "$partial" "$target/secrets/.$ts.age.partial"; cleanup_work' EXIT

  db_exists "$DB_NAME" || die "database $DB_NAME does not exist"
  # pg_dump runs as postgres, so the dump holds the password-hash tables
  # too; root writes the files.
  runuser -u postgres -- pg_dump -Fc "$DB_NAME" >"$partial/db.dump" || die "pg_dump failed"
  runuser -u postgres -- pg_dumpall --globals-only --no-role-passwords >"$partial/globals.sql" || die "pg_dumpall --globals-only failed"
  tar -C "$STATE" -cf "$partial/billing-rates.tar" billing_rates.d || die "cannot archive $STATE/billing_rates.d"

  local sm smp key secrets_json=null
  sm=$(psql_value -d "$DB_NAME" -c "SELECT coalesce(json_agg(filename ORDER BY filename), '[]') FROM schema_migrations") ||
    die "cannot read schema_migrations"
  smp=$(psql_value -d "$DB_NAME" -c "SELECT coalesce(json_agg(filename ORDER BY filename), '[]') FROM schema_migrations_password") ||
    die "cannot read schema_migrations_password"
  key=$(env_value CLOVER_COLUMN_ENCRYPTION_KEY)
  [[ -n $key ]] || die "$ENV_FILE has no CLOVER_COLUMN_ENCRYPTION_KEY"

  if [[ -s $BACKUP_RECIPIENTS ]] && grep -q '^age1' "$BACKUP_RECIPIENTS"; then
    local age_part=$target/secrets/.$ts.age.partial
    tar -C / -cf - "${ETC#/}" | age -R "$BACKUP_RECIPIENTS" -o "$age_part" || die "encrypting $ETC with age failed"
    chmod 0600 "$age_part"
    secrets_json=$(jq -n --arg f "secrets/$ts.age" --arg s "$(sha_of "$age_part")" '{file: $f, sha256: $s}')
  else
    report warn "backup: no recipient in $BACKUP_RECIPIENTS, so $ETC (the column key) is NOT in this backup"
  fi

  local version rev
  version=$(sed -n 's/^version=//p' "$CURRENT/.ubicloud-release")
  rev=$(sed -n 's/^rev=//p' "$CURRENT/.ubicloud-release")
  jq -n --argjson format 1 --arg ts "$ts" --arg host "$(hostname)" \
    --arg version "$version" --arg rev "$rev" \
    --argjson sm "$sm" --argjson smp "$smp" \
    --arg dump "$(sha_of "$partial/db.dump")" --arg globals "$(sha_of "$partial/globals.sql")" \
    --arg rates "$(sha_of "$partial/billing-rates.tar")" \
    --arg keyfp "$(key_fingerprint "$key")" --argjson secrets "$secrets_json" \
    '{format: $format, timestamp: $ts, host: $host, version: $version, rev: $rev,
      schema_migrations: $sm, schema_migrations_password: $smp,
      files: {"db.dump": $dump, "globals.sql": $globals, "billing-rates.tar": $rates},
      column_key_sha256: $keyfp, secrets: $secrets}' >"$partial/manifest.json"
  chmod 0600 "$partial"/*
  [[ $secrets_json == null ]] || mv -T "$target/secrets/.$ts.age.partial" "$target/secrets/$ts.age"
  mv -T "$partial" "$dir"
  trap cleanup_work EXIT
  report ok "backup: $dir ($(du -sh "$dir" | cut -f1))"
  [[ $secrets_json == null ]] || report ok "backup: $target/secrets/$ts.age"
}

backup_list() {
  [[ $# -eq 0 ]] || usage_die "backup list takes no arguments"
  need_root
  local target d m
  target=$(backup_target)
  [[ -d $target ]] || die "$target does not exist"
  printf '%-18s %-8s %-10s %-12s %s\n' TIMESTAMP SIZE SECRETS VERSION MIGRATIONS
  while IFS= read -r d; do
    m=$target/$d/manifest.json
    if [[ -f $m ]]; then
      printf '%-18s %-8s %-10s %-12s %s\n' "$d" "$(du -sh "$target/$d" | cut -f1)" \
        "$(if jq -e '.secrets' "$m" >/dev/null; then [[ -f $target/secrets/$d.age ]] && echo yes || echo missing; else echo no; fi)" \
        "$(jq -r '.version' "$m")" "$(jq -r '"\(.schema_migrations | length)/\(.schema_migrations_password | length)"' "$m")"
    else
      printf '%-18s %-8s %s\n' "$d" "$(du -sh "$target/$d" | cut -f1)" "(no manifest; not a backup this command made)"
    fi
  done < <(find "$target" -mindepth 1 -maxdepth 1 -type d ! -name secrets ! -name '.*' -printf '%f\n' | sort)
}

backup_prune() {
  local keep=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --keep)
        [[ $# -ge 2 ]] || usage_die "--keep needs a number"
        keep=$2
        shift
        ;;
      *) usage_die "backup prune takes --keep N" ;;
    esac
    shift
  done
  [[ $keep =~ ^[1-9][0-9]*$ ]] || usage_die "backup prune needs --keep N, with N at least 1"
  need_root
  audit "backup prune"
  local target all=() d n=0
  target=$(backup_target)
  take_lock 600
  mapfile -t all < <(find "$target" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | grep -E "$TS_RE" | sort -r)
  for d in "${all[@]:keep}"; do
    rm -rf "${target:?}/$d"
    rm -f "$target/secrets/$d.age"
    n=$((n + 1))
  done
  report ok "backup: kept $((${#all[@]} - n)), removed $n in $target"
}

# --- restore --------------------------------------------------------------------------

cmd_restore() {
  local ts="" key_file="" mode=all force=0 no_start=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --key-file)
        [[ $# -ge 2 && -n $2 ]] || usage_die "--key-file needs a file"
        key_file=$2
        shift
        ;;
      --env-only) [[ $mode == all ]] || usage_die "give --env-only or --db-only, not both"; mode="env" ;;
      --db-only) [[ $mode == all ]] || usage_die "give --env-only or --db-only, not both"; mode="db" ;;
      --force) force=1 ;;
      --no-start) no_start=1 ;;
      -*) usage_die "unknown restore option $1" ;;
      *)
        [[ -z $ts ]] || usage_die "restore takes one timestamp"
        ts=$1
        ;;
    esac
    shift
  done
  [[ $ts =~ $TS_RE ]] || usage_die "restore needs a backup timestamp such as 20261014T031500Z (ubicloud-admin backup list)"
  [[ $mode != env || $no_start == 0 ]] || usage_die "--no-start applies to a database restore, not to --env-only"
  [[ $mode == db || -n $key_file ]] || usage_die "restore needs --key-file F, the age identity of a backup recipient (or --db-only)"
  [[ -z $key_file || -f $key_file ]] || usage_die "--key-file $key_file is not a file"
  need_root
  [[ -d $CURRENT/ ]] || die "no release at $CURRENT (install with scripts/byoh/install.sh first)"
  audit restore
  local target dir
  target=$(backup_target)
  dir=$target/$ts
  [[ -f $dir/manifest.json ]] || usage_die "$dir/manifest.json does not exist (ubicloud-admin backup list)"
  take_lock 600
  make_work

  # 1. The backup is whole and this release can run it.
  restore_check_files "$dir" "$mode" "$target"
  restore_check_migrations "$dir/manifest.json"

  # 2. The env file: from the backup, or the current one.
  local env_src="" replace_env=0
  if [[ $mode != db ]]; then
    restore_decrypt "$target/secrets/$ts.age" "$key_file"
    env_src=$WORK/secrets/${ETC#/}/env
    [[ -f $env_src ]] || die "the secrets of $ts hold no ${ETC#/}/env"
    kv_read "$env_src"
    [[ -n ${KV[CLOVER_COLUMN_ENCRYPTION_KEY]:-} ]] || die "the env file of $ts has no CLOVER_COLUMN_ENCRYPTION_KEY"
  fi
  restore_plan_env "$dir/manifest.json" "$env_src" "$force" "$mode"
  replace_env=$REPLACE_ENV

  if [[ $mode == env ]]; then
    restore_install_env "$replace_env"
    restore_install_secrets "$force"
    local active
    active=$(unit_state ubicloud.target)
    if ((replace_env)) && [[ $active == active ]]; then
      systemctl try-restart ubicloud.target
      report changed "services: restarted with the restored env file"
    fi
    [[ -z $ENV_SAVED ]] || report notice "restore: the env file before the restore is $ENV_SAVED (root 0600)"
    return 0
  fi

  # 3. The restored database, built beside the live one.
  restore_build_db "$dir"

  # 4. The swap: the first step that touches the live control plane.
  # From here every failure puts back the database, /etc/ubicloud and
  # the billing rates as they were (restore_rollback).
  RB_TS=$ts
  RB_PREV=${DB_NAME}_prev_$(date -u +%Y%m%d%H%M%S)
  RB_WAS=$(active_services)
  restore_snapshot
  RB_HAD_LIVE=0
  db_exists "$DB_NAME" && RB_HAD_LIVE=1
  RB_ARMED=1
  trap 'restore_exit_trap' EXIT
  stop_services
  if ((RB_HAD_LIVE)); then
    rename_db_try "$DB_NAME" "$RB_PREV" || {
      restore_rollback
      die "cannot rename database $DB_NAME to $RB_PREV; the live database is back as it was"
    }
  fi
  rename_db_try "${DB_NAME}_restore" "$DB_NAME" || {
    restore_rollback
    die "renaming ${DB_NAME}_restore failed; the live database is back as it was"
  }
  RB_SWAPPED=1
  ((RB_HAD_LIVE)) && report changed "database: $DB_NAME is now $RB_PREV"
  report changed "database: ${DB_NAME}_restore is now $DB_NAME"

  # 5. Migrations of the release on the restored data: they need only
  # the env file. The other files of the backup follow once they ran.
  restore_install_env "$replace_env"
  if ! ruby_as ubicloud-migrate bin/rake-task-runner migrate "" 0 >"$WORK/migrate.log" 2>&1; then
    grep -v -i 'password' "$WORK/migrate.log" | tail -20 >&2
    report fail "restore: migrations failed on the restored database; putting the old control plane back"
    restore_rollback
    die "restore of $ts failed in its migrations; database $DB_NAME, $ETC and $STATE/billing_rates.d are as before${RB_FAILED:+, the restored copy is $RB_FAILED}"
  fi
  report ok "restore: migrations ran ($(grep -c 'Finished applying migration' "$WORK/migrate.log" || true) applied)"
  restore_install_secrets "$force"
  restore_billing_rates "$dir" "$force"
  # current and the restored database agree now (restore_check_migrations
  # and the migrations above).
  hold_clear
  ((no_start)) || start_services "$RB_WAS ubicloud.target"
  RB_ARMED=0
  trap cleanup_work EXIT
  [[ -z $ENV_SAVED ]] || report notice "restore: the env file before the restore is $ENV_SAVED (root 0600)"
  ((RB_HAD_LIVE == 0)) || report notice "restore: the database before the restore is $RB_PREV; drop it once the restore is checked (runuser -u postgres -- dropdb $RB_PREV)"
  report ok "restore: $ts restored"
  if ((no_start)); then
    report notice "restore: the services stay stopped (--no-start); systemctl start ubicloud.target starts them"
    return 0
  fi
  wait_web 120 || report warn "restore: web does not answer after 120 s (ubicloud-admin logs web)"
  echo
  local rc=0
  cmd_status || rc=$?
  ((rc == 0)) || report warn "restore: the restore finished, but status reports failures (above)"
  return 0
}

# The state restore_rollback puts back: set by cmd_restore at the swap.
RB_ARMED=0 RB_SWAPPED=0 RB_HAD_LIVE=0 RB_PREV="" RB_WAS="" RB_TS="" RB_FAILED=""

# Copies /etc/ubicloud and the billing rates before the swap.
restore_snapshot() {
  # Also keeps restore_rollback's copy back out of a symlink.
  secure_state
  cp -a "$ETC" "$WORK/etc.before"
  if [[ -d $STATE/billing_rates.d ]]; then
    cp -a "$STATE/billing_rates.d" "$WORK/rates.before"
  fi
}

# Puts back what the restore changed since the swap, keeping the
# restored database as ubicloud_failed_<time>, and starts the services
# that ran before. Never exits: the caller reports.
restore_rollback() {
  RB_ARMED=0
  set +e
  stop_services
  if ((RB_SWAPPED)); then
    RB_FAILED=${DB_NAME}_failed_$(date -u +%Y%m%d%H%M%S)
    rename_db_try "$DB_NAME" "$RB_FAILED" ||
      report fail "restore: cannot rename the restored $DB_NAME to $RB_FAILED; do it by hand (sudo -u postgres psql)"
  fi
  if ((RB_HAD_LIVE)) && ! db_exists "$DB_NAME"; then
    rename_db_try "$RB_PREV" "$DB_NAME" ||
      report fail "restore: cannot rename $RB_PREV back to $DB_NAME; do it by hand (sudo -u postgres psql), then start ubicloud.target"
  fi
  if [[ -d $WORK/etc.before ]]; then
    rm -rf "$ETC.rollback"
    if ! { cp -a "$WORK/etc.before" "$ETC.rollback" && rm -rf "$ETC" && mv -T "$ETC.rollback" "$ETC"; }; then
      report fail "restore: cannot put $ETC back; a copy from before the restore is in $ETC.rollback"
    fi
  fi
  if [[ -d $WORK/rates.before ]]; then
    if ! { rm -rf "$STATE/billing_rates.d" && cp -a "$WORK/rates.before" "$STATE/billing_rates.d"; }; then
      report fail "restore: cannot put $STATE/billing_rates.d back"
    fi
  fi
  ENV_SAVED=""
  start_services "$RB_WAS"
  set -e
}

# The EXIT trap between the swap and the start: an unexpected failure
# (set -e, a die) rolls back too.
restore_exit_trap() {
  local rc=$?
  if ((RB_ARMED)); then
    printf 'ubicloud-admin: the restore of %s stopped (exit %s) after the swap; putting the old control plane back\n' "$RB_TS" "$rc" >&2
    restore_rollback
    printf 'ubicloud-admin: database %s, %s and %s/billing_rates.d are as before%s\n' "$DB_NAME" "$ETC" "$STATE" "${RB_FAILED:+; the restored copy is $RB_FAILED}" >&2
  fi
  cleanup_work
}

restore_check_files() {
  local dir=$1 mode=$2 target=$3 m=$1/manifest.json f want
  jq -e '.format == 1' "$m" >/dev/null 2>&1 || die "$m is not a backup manifest of this format"
  if [[ $mode != env ]]; then
    for f in db.dump globals.sql billing-rates.tar; do
      want=$(jq -r --arg f "$f" '.files[$f] // empty' "$m")
      [[ -f $dir/$f && -n $want && $(sha_of "$dir/$f") == "$want" ]] ||
        die "$dir/$f is missing or does not match its sha256 in the manifest; nothing was changed" 2
    done
    runuser -u postgres -- pg_restore --list <"$dir/db.dump" >"$WORK/toc" 2>"$WORK/list.err" ||
      die "pg_restore --list cannot read $dir/db.dump ($(head -1 "$WORK/list.err")); nothing was changed" 2
    # restore_build_db creates the extensions as postgres and skips the
    # dump's own entries for them, which only a superuser may run.
    local ext others=()
    while IFS= read -r ext; do
      [[ $ext == citext || $ext == btree_gist ]] || others+=("$ext")
    done < <(sed -nE 's/^[0-9]+; [0-9]+ [0-9]+ EXTENSION - ([^ ]+).*/\1/p' "$WORK/toc")
    ((${#others[@]} == 0)) ||
      die "$dir/db.dump uses extension(s) ${others[*]}, which a restore does not create (only citext and btree_gist); nothing was changed" 2
    report ok "restore: $dir matches its manifest"
  fi
  if [[ $mode != db ]]; then
    local ts=${dir##*/} s
    s=$target/secrets/$ts.age
    want=$(jq -r '.secrets.sha256 // empty' "$m")
    [[ -n $want ]] || die "backup $ts holds no secrets (it was made without a recipient); use --db-only with the current env file" 2
    [[ -f $s && $(sha_of "$s") == "$want" ]] || die "$s is missing or does not match its sha256; nothing was changed" 2
  fi
}

# The release must know every migration of the backup: running an older
# release on newer data is a downgrade.
restore_check_migrations() {
  local m=$1 f missing=()
  while IFS= read -r f; do
    [[ -f $CURRENT/migrate/$f ]] || missing+=("$f")
  done < <(jq -r '.schema_migrations[]' "$m")
  while IFS= read -r f; do
    [[ -f $CURRENT/migrate/ph/$f ]] || missing+=("ph/$f")
  done < <(jq -r '.schema_migrations_password[]' "$m")
  ((${#missing[@]} == 0)) ||
    die "the backup has ${#missing[@]} migration(s) this release lacks (${missing[*]:0:3}); restore it with the release that made it ($(jq -r '.version' "$m")); nothing was changed" 2
}

restore_decrypt() {
  local file=$1 key=$2
  install -d -m 0700 "$WORK/secrets"
  age -d -i "$key" "$file" 2>"$WORK/age.err" | tar -C "$WORK/secrets" -xf - 2>>"$WORK/age.err" || {
    sed 's/^/  /' "$WORK/age.err" >&2
    die "cannot decrypt ${file##*/} with --key-file $key; nothing was changed" 2
  }
}

# Decides whether the restore replaces the env file (REPLACE_ENV) and
# refuses a column key that does not belong to the backup.
REPLACE_ENV=0
restore_plan_env() {
  local m=$1 env_src=$2 force=$3 mode=$4 want cur=""
  want=$(jq -r '.column_key_sha256' "$m")
  if [[ -e $ENV_FILE ]]; then
    kv_read "$ENV_FILE"
    cur=${KV[CLOVER_COLUMN_ENCRYPTION_KEY]:-}
  fi
  REPLACE_ENV=0
  if [[ $mode == db ]]; then
    [[ -n $cur ]] || die "$ENV_FILE is missing or has no column key; --db-only keeps the env file, so restore it too (drop --db-only)" 2
    if [[ $(key_fingerprint "$cur") != "$want" ]]; then
      ((force)) || die "the backup was made with another CLOVER_COLUMN_ENCRYPTION_KEY than $ENV_FILE holds, so its encrypted columns would be unreadable; restore the env file too (drop --db-only), or pass --force" 2
      report warn "restore: --force: the backup's column key differs from $ENV_FILE's"
    fi
    return 0
  fi
  kv_read "$env_src"
  [[ $(key_fingerprint "${KV[CLOVER_COLUMN_ENCRYPTION_KEY]}") == "$want" ]] ||
    die "the env file in the secrets of this backup does not hold the column key its manifest names; nothing was changed"
  local k
  for k in "${KV_KEYS[@]}"; do
    [[ ! $k =~ $INTERP_KEY_RE ]] ||
      die "the env file in the secrets of this backup sets $k, which loads code into the services; nothing was changed" 2
  done
  if [[ -z $cur ]]; then
    REPLACE_ENV=1
  elif [[ $(key_fingerprint "$cur") != "$want" ]]; then
    ((force)) || die "$ENV_FILE holds another CLOVER_COLUMN_ENCRYPTION_KEY than the backup; pass --force to replace the env file with the backup's (the current one is kept as env.before-restore-*)" 2
    REPLACE_ENV=1
  elif ((force)); then
    REPLACE_ENV=1
  else
    report ok "restore: $ENV_FILE has the backup's column key; it is kept (--force replaces it with the backup's)"
  fi
}

# restore_install_env REPLACE: installs the env file of the backup when
# REPLACE is 1, keeping the current one as env.before-restore-<time>
# (ENV_SAVED).
ENV_SAVED=""
restore_install_env() {
  local replace=$1 src=$WORK/secrets/${ETC#/}
  ((replace)) || return 0
  install -d -m 0755 -o root -g root "$ETC"
  if [[ -e $ENV_FILE ]]; then
    ENV_SAVED=$ETC/env.before-restore-$(date -u +%Y%m%dT%H%M%SZ)
    cp -p "$ENV_FILE" "$ENV_SAVED"
    chmod 0600 "$ENV_SAVED"
  fi
  install -m 0600 -o root -g root "$src/env" "$ENV_FILE.new"
  mv -f "$ENV_FILE.new" "$ENV_FILE"
  report changed "restore: $ENV_FILE from the backup"
}

# restore_install_secrets FORCE: the TLS files, tunnel token and backup
# settings of the backup that are missing here (all of them with FORCE).
restore_install_secrets() {
  local force=$1 src=$WORK/secrets/${ETC#/} f
  [[ -d $src ]] || return 0
  install -d -m 0755 -o root -g root "$ETC"
  if [[ -d $src/tls && (! -d $ETC/tls || $force == 1) ]]; then
    rm -rf "$ETC/tls.new"
    cp -a "$src/tls" "$ETC/tls.new"
    rm -rf "$ETC/tls"
    mv -T "$ETC/tls.new" "$ETC/tls"
    report changed "restore: $ETC/tls from the backup (restart the front: systemctl restart caddy)"
  fi
  for f in cloudflared.token backup.conf front.conf backup-recipients; do
    if [[ -f $src/$f && (! -e $ETC/$f || $force == 1) ]] && ! cmp -s "$src/$f" "$ETC/$f"; then
      cp -p "$src/$f" "$ETC/$f.new"
      mv -f "$ETC/$f.new" "$ETC/$f"
      report changed "restore: $ETC/$f from the backup"
    fi
  done
}

# Restores the billing rates that are missing (all with --force).
restore_billing_rates() {
  local dir=$1 force=$2
  mkdir "$WORK/rates"
  tar -C "$WORK/rates" -xf "$dir/billing-rates.tar"
  local f n=0
  secure_state
  install -d -m 0750 -o ubicloud -g ubicloud "$STATE/billing_rates.d"
  shopt -s nullglob
  for f in "$WORK/rates/billing_rates.d"/*; do
    # A symlink in the archive would make root copy what it points to.
    if [[ -L $f || ! -f $f ]]; then
      report warn "restore: skipped ${f##*/} in the backup's billing rates: not a regular file"
      continue
    fi
    if [[ ! -e $STATE/billing_rates.d/${f##*/} || $force == 1 ]] && ! cmp -s "$f" "$STATE/billing_rates.d/${f##*/}"; then
      install -m 0640 -o ubicloud -g ubicloud "$f" "$STATE/billing_rates.d/${f##*/}"
      n=$((n + 1))
    fi
  done
  shopt -u nullglob
  ((n == 0)) || report changed "restore: $n billing rate file(s) into $STATE/billing_rates.d"
}

# Builds ubicloud_restore from the dump. pg_restore logs in as role
# ubicloud_restorer (install.sh: a member of ubicloud and
# ubicloud_password, peer-mapped from ubicloud-migrate, database
# ubicloud_restore only), never as a superuser, so the SQL of a dump can
# do no more than the application's roles could.
restore_build_db() {
  local dir=$1 r
  for r in ubicloud ubicloud_password ubicloud_restorer; do
    [[ -n $(psql_value -d postgres -c "SELECT 1 FROM pg_roles WHERE rolname = '$r'") ]] ||
      die "database role $r does not exist; run scripts/byoh/install.sh of this release first"
  done
  if db_exists "${DB_NAME}_restore"; then
    runuser -u postgres -- dropdb "${DB_NAME}_restore"
    report notice "restore: dropped ${DB_NAME}_restore, left by an earlier restore that did not finish"
  fi
  runuser -u postgres -- createdb -O ubicloud "${DB_NAME}_restore"
  # The password-hash objects go to ubicloud_password, which needs CREATE
  # on public for that, as bin/rake-task-runner grants it for the ph
  # migrations.
  psql_admin -d "${DB_NAME}_restore" -c 'CREATE EXTENSION citext' -c 'CREATE EXTENSION btree_gist' \
    -c 'ALTER SCHEMA public OWNER TO ubicloud' -c 'GRANT CREATE ON SCHEMA public TO ubicloud_password'
  # The list without the entries restore_check_files checked: the
  # extensions and the public schema exist already.
  local list_dir mgroup
  mgroup=$(id -gn ubicloud-migrate)
  list_dir=$(mktemp -d /tmp/ubicloud-admin-restore.XXXXXX)
  CLEAN_PATHS+=("$list_dir")
  chown "root:$mgroup" "$list_dir"
  chmod 0750 "$list_dir"
  grep -vE '^[0-9]+; [0-9]+ [0-9]+ (EXTENSION - |COMMENT - EXTENSION |SCHEMA - public )' "$WORK/toc" >"$list_dir/toc" || true
  chown "root:$mgroup" "$list_dir/toc"
  chmod 0640 "$list_dir/toc"
  if ! env -i PATH=/usr/bin:/bin LANG=C.UTF-8 setpriv --reuid=ubicloud-migrate --regid="$mgroup" --init-groups -- \
    pg_restore --exit-on-error --no-password -U ubicloud_restorer -d "${DB_NAME}_restore" -L "$list_dir/toc" <"$dir/db.dump" 2>"$WORK/restore.err"; then
    head -5 "$WORK/restore.err" >&2
    runuser -u postgres -- dropdb "${DB_NAME}_restore" || true
    die "pg_restore into ${DB_NAME}_restore failed; the live database was not touched"
  fi
  psql_admin -d "${DB_NAME}_restore" -c 'REVOKE ALL ON SCHEMA public FROM ubicloud_password'
  local n want
  n=$(psql_value -d "${DB_NAME}_restore" -c 'SELECT count(*) FROM schema_migrations')
  want=$(jq -r '.schema_migrations | length' "$dir/manifest.json")
  [[ $n == "$want" ]] || {
    runuser -u postgres -- dropdb "${DB_NAME}_restore" || true
    die "the restored database has $n migrations, the manifest $want; the live database was not touched"
  }
  report ok "restore: built ${DB_NAME}_restore ($n migrations)"
}

# The services among SERVICES that run now: active, or on their way in
# or out (activating, deactivating, reloading). systemctl stop
# ubicloud.target can return while respirate still finishes its strands.
running_services() {
  local u out=""
  for u in "${SERVICES[@]}" ubicloud.target; do
    [[ $(unit_state "$u") =~ ^(inactive|failed|unknown)?$ ]] || out+=" $u"
  done
  printf '%s' "${out# }"
}

# The services among SERVICES that are active: what a restore starts
# again.
active_services() {
  local u out=""
  for u in "${SERVICES[@]}" ubicloud.target; do
    [[ $(unit_state "$u") != active ]] || out+=" $u"
  done
  printf '%s' "${out# }"
}

stop_services() {
  systemctl stop ubicloud.target "${SERVICES[@]}"
}

# start_services "UNIT...": starts the units that ran before.
start_services() {
  local units
  read -r -a units <<<"$1"
  ((${#units[@]} == 0)) || systemctl start "${units[@]}"
}

# rename_db_try FROM TO: renames a database nobody is connected to; a
# session that connects in between (a console, a stray psql) is ended.
rename_db_try() {
  local _
  for _ in 1 2 3 4 5; do
    psql_value -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$1' AND pid <> pg_backend_pid()" >/dev/null
    psql_value -d postgres -c "ALTER DATABASE \"$1\" RENAME TO \"$2\"" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}


# --- env --------------------------------------------------------------------------------

# Keys env set and env unset refuse, with the reason. install.sh owns
# the keys of its flags: a value set here would make its next run exit
# 2 with a conflict, and BASE_URL must match the host the front serves.
env_refusal() {
  case $1 in
    PRY_ALLOW_UNAUDITED) echo "it would let bin/pry run unaudited from every service; ubicloud-admin console sets it for its own session" ;;
    CLOVER_COLUMN_ENCRYPTION_KEY) echo "another key makes every encrypted column unreadable; restore the env file from a backup instead" ;;
    CLOVER_SESSION_SECRET) echo "Rodauth hashes every password and signs every token with it, so another value locks every account out; rotating it needs its own procedure" ;;
    CLOVER_RUNTIME_TOKEN_SECRET) echo "another value invalidates the runtime token of every VM; rotating it needs its own procedure" ;;
    GIT_REV) echo "the release's .release-env sets it" ;;
    IP_FROM_HEADER) echo "it follows the TLS front; change it with install.sh --tls ... --update-env IP_FROM_HEADER" ;;
    BASE_URL) echo "the TLS front serves the host of install.sh --url; change it with install.sh --url URL --update-env BASE_URL" ;;
    RACK_ENV) echo "install.sh sets it; change it with install.sh --rack-env ENV --update-env RACK_ENV" ;;
    MAIL_FROM) echo "install.sh --mail-from owns it; change it with install.sh --mail-from ADDR --update-env MAIL_FROM" ;;
    MAIL_DRIVER | SMTP_*) echo "install.sh --smtp-file owns the mail settings; change them with install.sh --smtp-file F --update-env $1" ;;
    *)
      [[ $1 =~ $INTERP_KEY_RE ]] || return 1
      echo "it loads code into Ruby, bundler or node in every service"
      ;;
  esac
}

# Keys config.rb requires: the services do not start without them.
readonly MANDATORY_KEY_RE='^(CLOVER_DATABASE_URL|CLOVER_SESSION_SECRET|CLOVER_COLUMN_ENCRYPTION_KEY|RACK_ENV)$'

cmd_env() {
  local sub=${1:-} key="" restart=1 reveal=0
  shift || true
  while [[ $# -gt 0 ]]; do
    case $1 in
      --no-restart) restart=0 ;;
      --reveal) reveal=1 ;;
      -*) usage_die "unknown env option $1" ;;
      *)
        [[ -z $key ]] || usage_die "env $sub takes one key"
        key=$1
        ;;
    esac
    shift
  done
  need_root
  need_release
  case $sub in
    keys)
      [[ -z $key ]] || usage_die "env keys takes no key"
      kv_read "$ENV_FILE"
      printf '%s\n' "${KV_KEYS[@]}"
      return 0
      ;;
    get | set | unset) ;;
    *) usage_die "env takes set KEY, unset KEY, get KEY --reveal or keys" ;;
  esac
  [[ $key =~ $KEY_RE ]] || usage_die "env $sub needs a key name, such as MAIL_FROM"
  [[ ! $key =~ $DENIED_KEY_RE ]] || usage_die "the env file must not set $key"
  if [[ $sub == get ]]; then
    ((reveal)) || usage_die "env get prints a value, which may be a secret; pass --reveal"
    audit "env get --reveal"
    kv_read "$ENV_FILE"
    [[ -n ${KV[$key]+x} ]] || die "$ENV_FILE does not set $key"
    printf '%s\n' "${KV[$key]}"
    return 0
  fi
  local why
  if [[ $sub == unset && $key =~ $MANDATORY_KEY_RE ]]; then
    usage_die "env unset $key is refused: the services do not start without it"
  fi
  # Removing PRY_ALLOW_UNAUDITED or a code-loading key only helps.
  if why=$(env_refusal "$key"); then
    [[ $sub == unset && ($key == PRY_ALLOW_UNAUDITED || $key =~ $INTERP_KEY_RE) ]] || usage_die "env $sub $key is refused: $why"
  fi
  local value=""
  if [[ $sub == set ]]; then
    value=$(read_value "$key")
    [[ -n $value ]] || usage_die "the value is empty; use env unset $key to remove the key"
    valid_value "$value" || usage_die "the value contains a quote, backslash, newline or CR, which $ENV_FILE cannot hold"
    [[ $key != PORT || $value != "$CHECK_PORT" ]] ||
      usage_die "PORT $CHECK_PORT is reserved for the puma of bin/production_check (ubicloud-admin smoke); choose another port"
  fi
  audit "env $sub"
  take_lock 60
  kv_read "$ENV_FILE"
  local out=() line found=0
  for line in "${KV_LINES[@]}"; do
    if [[ $line == "$key='"* ]]; then
      found=1
      [[ $sub == unset ]] && continue
      out+=("$key='$value'")
    else
      out+=("$line")
    fi
  done
  if [[ $sub == set ]]; then
    ((found)) || out+=("$key='$value'")
  elif ((!found)); then
    report ok "env: $key is not set"
    return 0
  fi
  make_work
  cp -p "$ENV_FILE" "$WORK/env.before"
  install -m 0600 -o root -g root /dev/null "$ENV_FILE.new"
  printf '%s\n' "${out[@]}" >"$ENV_FILE.new"
  mv -f "$ENV_FILE.new" "$ENV_FILE"
  report changed "env: $sub $key"
  if ((restart)) && [[ $(unit_state ubicloud.target) == active ]]; then
    systemctl try-restart ubicloud.target
    # Back to back restarts would stop puma while it loads the app.
    if wait_web 120; then
      report changed "services: restarted ubicloud.target; web answers"
    else
      report fail "services: web does not answer after 120 s with the new $ENV_FILE; putting the old one back"
      install -m 0600 -o root -g root "$WORK/env.before" "$ENV_FILE.new"
      mv -f "$ENV_FILE.new" "$ENV_FILE"
      systemctl try-restart ubicloud.target
      if wait_web 120; then
        die "env $sub $key is undone: web did not answer with it (ubicloud-admin logs web); $ENV_FILE is as before and web answers"
      fi
      die "env $sub $key is undone, but web does not answer with the old $ENV_FILE either (ubicloud-admin logs web)"
    fi
  elif ((restart)); then
    report ok "services: ubicloud.target is not running; the next start reads $ENV_FILE"
  else
    report notice "services: not restarted (--no-restart); they read $ENV_FILE at their next start"
  fi
}

# read_value KEY: the value from stdin, typed without echo on a terminal.
# One trailing newline is dropped; a NUL is refused.
read_value() {
  local v tmp
  if [[ -t 0 ]]; then
    IFS= read -r -s -p "value for $1: " v
    echo >&2
    printf '%s' "$v"
    return 0
  fi
  make_work
  tmp=$WORK/value
  cat >"$tmp"
  [[ $(wc -c <"$tmp") == "$(tr -d '\000' <"$tmp" | wc -c)" ]] || usage_die "the value contains a NUL byte"
  v=$(
    cat "$tmp"
    printf x
  )
  v=${v%x}
  printf '%s' "${v%$'\n'}"
}

# --- logs -------------------------------------------------------------------------------

cmd_logs() {
  local args=() units=() u
  while [[ $# -gt 0 ]]; do
    case $1 in
      -f | --follow) args+=(-f) ;;
      --since | -n | --lines | --until)
        [[ $# -ge 2 ]] || usage_die "$1 needs a value"
        args+=("$1" "$2")
        shift
        ;;
      web | respirate | monitor) units+=("ubicloud-$1.service") ;;
      backup) units+=(ubicloud-backup.service) ;;
      caddy) units+=(caddy.service) ;;
      cloudflared) units+=(cloudflared.service ubicloud-cloudflared.service) ;;
      *) usage_die "logs takes web, respirate, monitor, backup, caddy or cloudflared, and -f, --since T, --until T, -n N" ;;
    esac
    shift
  done
  need_root
  ((${#units[@]})) || units=(ubicloud-web.service ubicloud-respirate.service ubicloud-monitor.service ubicloud-backup.service)
  local sel=()
  for u in "${units[@]}"; do sel+=(-u "$u"); done
  exec journalctl --no-pager "${sel[@]}" "${args[@]}"
}

# --- account and run --------------------------------------------------------------------

# Copies of the files a command names. The directory is root's and the
# copies are root:ubicloud 0440, so the tool (and anything else running
# as ubicloud) can read them but never replace one with a symlink that
# root then writes through. Only out.d, for --out, is ubicloud's.
STAGE_DIR=""
stage_dir() {
  if [[ -z $STAGE_DIR ]]; then
    make_work
    STAGE_DIR=$(mktemp -d /tmp/ubicloud-admin-files.XXXXXX)
    CLEAN_PATHS+=("$STAGE_DIR")
    chown root:ubicloud "$STAGE_DIR"
    chmod 0750 "$STAGE_DIR"
  fi
}

# stage_in FILE: copies FILE (relative to the caller's directory) for
# ubicloud and sets STAGED_PATH to the copy's path. It runs in the
# caller's shell, never in $(...), so that its usage_die ends the script
# even where errexit is off.
STAGED_PATH=""
stage_in() {
  local src=$1
  [[ $src == /* ]] || src=$CALLER_PWD/$src
  [[ -f $src && -r $src ]] || usage_die "$1 is not a readable file"
  stage_dir
  STAGED_PATH=$(mktemp "$STAGE_DIR/in.XXXXXX") || die "cannot create a file in $STAGE_DIR"
  install -m 0440 -o root -g ubicloud "$src" "$STAGED_PATH" || die "cannot copy $src to $STAGED_PATH"
}

# Input file options of the tools, and the output option.
readonly IN_FILE_OPTS='^--(pool-file|ssh-key|registration-key|external-map|password-file|snapshot)$'
# The staged copies of keys, which host add deletes after its prepare
# phase.
readonly KEY_FILE_OPTS='^--(ssh-key|registration-key)$'
STAGED_KEYS=()
OUT_FILE="" OUT_STAGED=""

# is_bmc_password_opt ARG: whether the CLI's OptionParser (optparse
# 0.8.1) could read ARG as --bmc-password. It turns _ into -, ignores
# case and takes a prefix of each word, so --bmc_password,
# --BMC-PASSWORD, --b-passw and --bmc-passw all are. Ambiguous spellings
# (--bmc-pass) count too; the CLI refuses those anyway.
is_bmc_password_opt() {
  local name=${1#--} re
  [[ $1 == --?* ]] || return 1
  name=${name%%=*}
  name=${name,,}
  name=${name//_/-}
  [[ $name =~ ^[a-z0-9-]+$ ]] || return 1
  re=$(sed -E 's/[a-z0-9]+/&[a-z0-9_]*/g' <<<"$name")
  [[ bmc-password =~ ^$re ]]
}

# stage_args ARGS...: sets STAGED_ARGS to ARGS with the files staged.
stage_args() {
  STAGED_ARGS=()
  local a opt val
  while [[ $# -gt 0 ]]; do
    a=$1
    if is_bmc_password_opt "$a"; then
      usage_die "--bmc-password would put the BMC password on a command line and store it in plain text; set it with 'ubicloud-admin env set BMC_PASS' and pass --bmc-pass-env BMC_PASS"
    fi
    if [[ $a == --*=* ]]; then
      opt=${a%%=*} val=${a#*=}
    else
      opt=$a val=""
    fi
    if [[ $opt =~ $IN_FILE_OPTS || $opt == --out ]]; then
      if [[ $a != --*=* ]]; then
        [[ $# -ge 2 ]] || usage_die "$opt needs a file"
        val=$2
        shift
      fi
      if [[ $opt == --out ]]; then
        [[ $val == /* ]] || val=$CALLER_PWD/$val
        [[ -d $(dirname "$val") ]] || usage_die "--out: the directory of $val does not exist"
        stage_dir
        install -d -m 0700 -o ubicloud -g ubicloud "$STAGE_DIR/out.d"
        OUT_FILE=$val
        OUT_STAGED=$STAGE_DIR/out.d/out
        STAGED_ARGS+=(--out "$OUT_STAGED")
      else
        # In this shell: its EXIT trap removes the copies.
        stage_dir
        stage_in "$val"
        val=$STAGED_PATH
        STAGED_ARGS+=("$opt" "$val")
        [[ ! $opt =~ $KEY_FILE_OPTS ]] || STAGED_KEYS+=("$val")
      fi
    else
      STAGED_ARGS+=("$a")
    fi
    shift
  done
}

# Writes the staged --out file to where the caller asked, owned by the
# caller. out.d is ubicloud's, so the file is read as ubicloud: a symlink
# there reaches only what ubicloud could read anyway.
deliver_out() {
  [[ -n $OUT_FILE ]] || return 0
  [[ -e $OUT_STAGED || -L $OUT_STAGED ]] || return 0
  [[ -f $OUT_STAGED && ! -L $OUT_STAGED ]] || die "the --out file the tool wrote is not a regular file; nothing was written to $OUT_FILE"
  setpriv --reuid=ubicloud --regid=ubicloud --init-groups -- cat -- "$OUT_STAGED" >"$WORK/out" ||
    die "cannot read the --out file the tool wrote; nothing was written to $OUT_FILE"
  install -m 0600 -o "${SUDO_UID:-0}" -g "${SUDO_GID:-0}" "$WORK/out" "$OUT_FILE"
}

cmd_account() {
  local sub=${1:-}
  case $sub in
    create | list) ;;
    *) usage_die "account takes create or list" ;;
  esac
  need_root
  need_release
  audit "account $sub"
  stage_args "$@"
  # The output is the caller's: a generated password is printed there,
  # so it is never logged or copied.
  ruby_as ubicloud bin/byoh-account "${STAGED_ARGS[@]}"
}

cmd_run() {
  local tool=${1:-}
  shift || true
  local cmd=()
  case $tool in
    byoh-location | byoh-pool | byoh-host | register-byoh-host | byoh-virt | byoh-config-check | production_check)
      cmd=("bin/$tool")
      ;;
    create_prod_admin_account) cmd=(bin/rake-task-runner create_prod_admin_account) ;;
    m2-checks) cmd=(scripts/byoh/verify/m2-checks) ;;
    "") usage_die "run needs a tool: byoh-location, byoh-pool, byoh-host, register-byoh-host, byoh-virt, byoh-config-check, production_check, create_prod_admin_account or m2-checks" ;;
    *) usage_die "run does not run $tool; it runs byoh-location, byoh-pool, byoh-host, register-byoh-host, byoh-virt, byoh-config-check, production_check, create_prod_admin_account and m2-checks" ;;
  esac
  need_root
  need_release
  stage_args "$@"
  audit "run $tool"
  local rc=0
  ruby_as ubicloud "${cmd[@]}" "${STAGED_ARGS[@]}" || rc=$?
  ((rc)) || deliver_out
  return "$rc"
}

# --- site, host and pool (M4) ------------------------------------------------------------

readonly SITE_VERBS=(add list show set rates grant revoke delete)
readonly HOST_VERBS=(add preflight watch move-location setup-egress-nat export-audit relearn-device-ids relearn-pci)
readonly POOL_VERBS=(list export add remove remap annotate ipv6 verify trace)
DEV=0
# packaged or dev, from byoh_layout.
LAYOUT=""

# byoh_layout: picks the layout the site, host and pool tools run in.
byoh_layout() {
  [[ ${UBICLOUD_ADMIN_DEV:-0} != 1 ]] || DEV=1
  if [[ -e $ETC || -e $OPT ]]; then
    ((DEV == 0)) || usage_die "--dev (or UBICLOUD_ADMIN_DEV=1) runs the tools of a development checkout, but $ETC or $OPT exists here (a packaged control plane); leave it out"
    LAYOUT=packaged
  elif ((DEV)); then
    LAYOUT=dev
  else
    die "no control plane here: neither $ETC nor $OPT exists (install with scripts/byoh/install.sh); in a development checkout, pass --dev"
  fi
}

# The development checkout this script is in.
dev_repo() {
  local repo
  repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
  [[ -f $repo/Gemfile && -f $repo/bin/byoh-location ]] || die "--dev: $repo is not a checkout (no Gemfile or bin/byoh-location); run the ubicloud-admin of the checkout, packaging/bin/ubicloud-admin"
  printf '%s' "$repo"
}

# dev_args ARGS...: sets DEV_ARGS to ARGS with the file options made
# absolute, as the tools run in the checkout, not the caller's
# directory.
dev_args() {
  DEV_ARGS=()
  local a opt val
  while [[ $# -gt 0 ]]; do
    a=$1
    if [[ $a == --*=* ]]; then
      opt=${a%%=*} val=${a#*=}
    else
      opt=$a val=""
    fi
    if [[ $opt =~ $IN_FILE_OPTS || $opt == --out ]]; then
      if [[ $a != --*=* ]]; then
        [[ $# -ge 2 ]] || usage_die "$opt needs a file"
        val=$2
        shift
      fi
      [[ $val == /* ]] || val=$CALLER_PWD/$val
      DEV_ARGS+=("$opt" "$val")
    else
      DEV_ARGS+=("$a")
    fi
    shift
  done
}

# dev_user: the user and home the dev tools run as; refuses root alone.
DEV_USER="" DEV_HOME=""
dev_user() {
  if [[ $EUID != 0 ]]; then
    DEV_USER=$(id -un)
    # The caller's HOME; as_service changes it only in its subshell.
    # shellcheck disable=SC2031
    DEV_HOME=$HOME
  elif [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
    DEV_USER=$SUDO_USER
    DEV_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    [[ -n $DEV_HOME ]] || die "--dev: no home directory for $SUDO_USER"
  else
    return 1
  fi
}

# dev_path REPO: PATH for the dev tools: mise's ~/.local/bin and the
# Ruby of the checkout's mise.toml, as scripts/byoh/bootstrap-dev-ctrl-plane.sh
# installs them, then the caller's PATH.
dev_path() {
  local ruby p=$DEV_HOME/.local/bin
  ruby=$(sed -n 's/^ruby *= *"\([^"]*\)".*/\1/p' "$1/mise.toml" 2>/dev/null | head -1)
  [[ -z $ruby || ! -d $DEV_HOME/.local/share/mise/installs/ruby/$ruby/bin ]] || p+=:$DEV_HOME/.local/share/mise/installs/ruby/$ruby/bin
  # The caller's PATH; as_service changes it only in its subshell.
  # shellcheck disable=SC2031
  printf '%s:%s' "$p" "$PATH"
}

# show_cmd ARGS...: one command line, quoted for a shell.
show_cmd() {
  local out
  printf -v out ' %q' "$@"
  printf '  %s\n' "${out# }"
}

# tool_run TOOL ARGS...: runs bin/TOOL with ARGS in the layout and sets
# TOOL_RC to its exit status; with UBICLOUD_ADMIN_DRYRUN=1 it prints the
# command line instead. It returns 0 itself, so that callers never put
# it left of || or in an if: errexit would be off for the staging
# inside, and a failed step there would go on with an empty path.
TOOL_RC=0
tool_run() {
  local tool=$1
  shift
  TOOL_RC=0
  if [[ $LAYOUT == dev ]]; then
    local repo
    repo=$(dev_repo)
    dev_args "$@"
    if [[ ${UBICLOUD_ADMIN_DRYRUN:-0} == 1 ]]; then
      show_cmd bundle exec "bin/$tool" "${DEV_ARGS[@]}"
      return 0
    fi
    if ! dev_user; then
      printf 'ubicloud-admin: --dev does not run the tools as root without sudo; run as the owner of the checkout:\n' >&2
      printf '  cd %q && bundle exec bin/%s' "$repo" "$tool" >&2
      printf ' %q' "${DEV_ARGS[@]}" >&2
      printf '\n' >&2
      exit 2
    fi
    local cmd=(env "HOME=$DEV_HOME" "PATH=$(dev_path "$repo")" bundle exec "bin/$tool" "${DEV_ARGS[@]}")
    (
      cd "$repo" || exit 1
      umask 022
      if [[ $EUID == 0 ]]; then exec runuser -u "$DEV_USER" -- "${cmd[@]}"; else exec "${cmd[@]}"; fi
    ) || TOOL_RC=$?
    return 0
  fi
  if [[ ${UBICLOUD_ADMIN_DRYRUN:-0} == 1 ]]; then
    show_cmd "bin/$tool" "$@"
    return 0
  fi
  stage_args "$@"
  ruby_as ubicloud "bin/$tool" "${STAGED_ARGS[@]}" || TOOL_RC=$?
  ((TOOL_RC)) || deliver_out
  return 0
}

# The digest of the billing rate files, to see whether a command
# changed them. Root never opens the files, which user ubicloud writes
# (it could swap one for a FIFO or a link to /dev/zero): find lists each
# entry's type, size, inode and nanosecond mtime from lstat, without
# following links. secure_state checked that the directory itself is no
# symlink, and $STATE is root's.
rates_digest() {
  local d=$STATE/billing_rates.d
  [[ -d $d && ! -L $d ]] || return 0
  find -P "$d" -mindepth 1 -maxdepth 1 -name '*.yml' -printf '%P\t%y\t%s\t%i\t%T@\n' | LC_ALL=C sort | sha256sum
}

# restart_for_rates: restarts ubicloud.target, so web, respirate and
# monitor load the changed rate files.
restart_for_rates() {
  if [[ $(unit_state ubicloud.target) != active ]]; then
    report ok "services: ubicloud.target is not running; its next start loads the new rates"
    return 0
  fi
  take_lock 60
  systemctl try-restart ubicloud.target
  # Back to back restarts would stop puma while it loads the app.
  if wait_web 120; then
    report changed "services: restarted ubicloud.target to load the new rates; web answers"
  else
    report fail "services: web does not answer 120 s after the restart (ubicloud-admin logs web)"
    return 1
  fi
}

# verb_ok VERB WORDS...: whether VERB is one of WORDS.
verb_ok() {
  local v=$1 w
  shift
  for w in "$@"; do [[ $v != "$w" ]] || return 0; done
  return 1
}

# cmd_byoh NOUN TOOL VERB ARGS...: site, host and pool.
cmd_byoh() {
  local noun=$1 tool=$2 verb=${3:-}
  shift 2
  shift || true
  local verbs=()
  case $noun in
    site) verbs=("${SITE_VERBS[@]}") ;;
    host) verbs=("${HOST_VERBS[@]}") ;;
    pool) verbs=("${POOL_VERBS[@]}") ;;
  esac
  local args=() a
  for a in "$@"; do
    if is_bmc_password_opt "$a"; then
      usage_die "--bmc-password would put the BMC password on a command line and store it in plain text; set it with 'ubicloud-admin env set BMC_PASS' and pass --bmc-pass-env BMC_PASS"
    fi
    if [[ $a == --dev ]]; then DEV=1; else args+=("$a"); fi
  done
  case $verb in
    -h | --help | help)
      byoh_layout
      if [[ $LAYOUT == packaged && ${UBICLOUD_ADMIN_DRYRUN:-0} != 1 ]]; then
        need_root
        need_release
      fi
      tool_run "$tool" --help
      return "$TOOL_RC"
      ;;
    "") usage_die "$noun takes one of: ${verbs[*]}" ;;
  esac
  verb_ok "$verb" "${verbs[@]}" || usage_die "$noun does not take $verb; it takes one of: ${verbs[*]}"
  byoh_layout
  local dry=0
  [[ ${UBICLOUD_ADMIN_DRYRUN:-0} != 1 ]] || dry=1
  if [[ $LAYOUT == packaged ]] && ((!dry)); then
    need_root
    need_release
  fi
  ((dry)) || audit "$noun $verb"
  if ((dry)); then
    if [[ $LAYOUT == dev ]]; then
      local repo
      repo=$(dev_repo)
      printf 'ubicloud-admin: dry run; in the checkout %s it would run:\n' "$repo"
    else
      printf 'ubicloud-admin: dry run; as user ubicloud in %s it would run:\n' "$CURRENT"
    fi
  fi
  if [[ $noun == host && $verb == add ]]; then
    host_add "${args[@]}"
    return
  fi
  if [[ $noun == site && ($verb == add || $verb == rates) && $LAYOUT == packaged ]] && ((!dry)); then
    local before rc=0
    before=$(rates_digest)
    SERVICE_EXTRA=(UBICLOUD_ADMIN_RESTARTS=1)
    tool_run "$tool" "$verb" "${args[@]}"
    rc=$TOOL_RC
    SERVICE_EXTRA=()
    # A run that failed after writing rates (a refused --grant) still
    # changed what the services must load.
    if [[ $(rates_digest) != "$before" ]]; then
      restart_for_rates || rc=1
    fi
    return "$rc"
  fi
  tool_run "$tool" "$verb" "${args[@]}"
  return "$TOOL_RC"
}

# host_add ARGS...: byoh-host add in two invocations, so that the
# operator's key is gone before the watch.
host_add() {
  local a
  for a in "$@"; do
    case $a in
      --phase | --phase=* | -h | --help)
        tool_run byoh-host add "$@"
        return "$TOOL_RC"
        ;;
    esac
  done
  if [[ $LAYOUT == packaged && ${UBICLOUD_ADMIN_DRYRUN:-0} != 1 ]]; then
    # Where the prepare phase keeps the registration key for the register
    # phase (install.sh makes it too; older layouts lack it).
    secure_state
    install -d -m 0700 -o ubicloud -g ubicloud "$STATE/byoh-keys"
  fi
  local rc=0
  tool_run byoh-host add "$@" --phase prepare
  rc=$TOOL_RC
  # The staged keys go now, whatever the outcome; the EXIT trap would
  # only remove them at the very end.
  if ((${#STAGED_KEYS[@]})); then
    rm -f -- "${STAGED_KEYS[@]}"
    printf 'ubicloud-admin: deleted the staged copies of the SSH keys before the register phase\n'
  fi
  [[ ${UBICLOUD_ADMIN_DRYRUN:-0} != 1 ]] || printf '  (then deletes the staged --ssh-key and --registration-key copies)\n'
  ((rc == 0)) || return "$rc"
  local reg=() skip=0
  for a in "$@"; do
    if ((skip)); then
      skip=0
      continue
    fi
    case $a in
      --ssh-key | --registration-key) skip=1 ;;
      --ssh-key=* | --registration-key=*) ;;
      *) reg+=("$a") ;;
    esac
  done
  tool_run byoh-host add "${reg[@]}" --phase register
  return "$TOOL_RC"
}

# --- console ----------------------------------------------------------------------------

cmd_console() {
  local code="" have_code=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      -e)
        [[ $# -ge 2 ]] || usage_die "-e needs code, or - to read it from stdin"
        code=$2
        have_code=1
        shift
        ;;
      *) usage_die "console takes only -e CODE or -e -" ;;
    esac
    shift
  done
  need_root
  need_release
  if ((have_code)) && [[ $code == - ]]; then
    make_work
    cat >"$WORK/code"
    [[ $(wc -c <"$WORK/code") == "$(tr -d '\000' <"$WORK/code" | wc -c)" ]] || usage_die "the code contains a NUL byte"
    code=$(
      cat "$WORK/code"
      printf x
    )
    code=${code%x}
  fi
  ((have_code == 0)) || [[ -n $code ]] || usage_die "-e needs code"
  local label=console
  ((have_code == 0)) || label+=" -e"
  audit "$label"
  # A throwaway HOME, so pry's history (which may hold secrets) never
  # lands in the state directory the services can read.
  make_work
  SERVICE_HOME=$(mktemp -d /tmp/ubicloud-console.XXXXXX)
  CLEAN_PATHS+=("$SERVICE_HOME")
  chown ubicloud:ubicloud "$SERVICE_HOME"
  SERVICE_EXTRA=("SUDO_USER=${SUDO_USER:-root}")
  # bin/pry audits to a sink when the env file names one; only without
  # one does this session need PRY_ALLOW_UNAUDITED.
  kv_read "$ENV_FILE"
  if [[ -z ${KV[PRY_AUDIT_BUCKET]:-} && -z ${KV[OTEL_EXPORTER_OTLP_ENDPOINT]:-} ]]; then
    SERVICE_EXTRA+=(PRY_ALLOW_UNAUDITED=true)
    printf 'ubicloud-admin: this console session is NOT audited (a system log line records who ran it)\n' >&2
  fi
  # The code reaches bin/pry in the environment, so no command line of
  # this run carries it (sudo still logs -e CODE; -e - avoids that).
  # bin/pry runs it as one pry input, through the audit sink if any.
  ((have_code == 0)) || SERVICE_EXTRA+=("UBICLOUD_CONSOLE_CODE=$code")
  # bin/pry's shebang asks for frozen string literals, but ruby ignores
  # it when it is given the script; Sshable#cmd refuses unfrozen strings.
  ruby_as ubicloud --enable-frozen-string-literal bin/pry
}

# --- release switch (WP10) ------------------------------------------------------------
#
# A release runs only on a schema it knows: every applied migration must
# be a file in its migrate/ (migrate/ph/ for schema_migrations_password),
# and its own migrations must have run. The full ubicloud-admin upgrade
# comes with M12; these are the guarded steps of the manual switch.

# The version a link such as current or previous points at, or nothing.
link_version() {
  local l
  l=$(readlink "$1" 2>/dev/null) || return 0
  printf '%s' "${l##*/}"
}

# release_dir VERSION: the directory of a built release; exits 2 otherwise.
release_dir() {
  local v=$1
  [[ $v =~ $VERSION_RE && $v != *.tmp ]] ||
    usage_die "a release version is letters, digits, '.', '_', '+' or '-' (ubicloud-admin release list)"
  [[ -d $RELEASES/$v && ! -L $RELEASES/$v && -f $RELEASES/$v/.ubicloud-release ]] ||
    usage_die "release $v is not in $RELEASES; build it with install.sh --stage release --version $v"
  printf '%s' "$RELEASES/$v"
}

# load_applied: APPLIED and APPLIED_PH, the migrations the database has
# applied.
APPLIED=() APPLIED_PH=()
load_applied() {
  local sm smp
  sm=$(psql_value -d "$DB_NAME" -c "SELECT filename FROM schema_migrations ORDER BY 1") ||
    die "cannot read schema_migrations of database $DB_NAME"
  smp=$(psql_value -d "$DB_NAME" -c "SELECT filename FROM schema_migrations_password ORDER BY 1") ||
    die "cannot read schema_migrations_password of database $DB_NAME"
  APPLIED=() APPLIED_PH=()
  [[ -z $sm ]] || mapfile -t APPLIED <<<"$sm"
  [[ -z $smp ]] || mapfile -t APPLIED_PH <<<"$smp"
}

# release_gaps DIR: LACKS, the applied migrations DIR has no file for
# (running DIR would be a downgrade onto a newer schema), and PENDING,
# the migrations of DIR not applied yet. rake-task-runner runs the ph
# migrations only on a database without both password tables, so only
# migrate/ counts for PENDING.
LACKS=() PENDING=()
release_gaps() {
  local dir=$1 f
  local -A have=()
  LACKS=() PENDING=()
  for f in "${APPLIED[@]}"; do
    have[$f]=1
    [[ -f $dir/migrate/$f ]] || LACKS+=("$f")
  done
  for f in "${APPLIED_PH[@]}"; do
    [[ -f $dir/migrate/ph/$f ]] || LACKS+=("ph/$f")
  done
  while IFS= read -r f; do
    [[ -n ${have[$f]:-} ]] || PENDING+=("$f")
  done < <(find "$dir/migrate" -maxdepth 1 -type f -name '[0-9]*_*.rb' -printf '%f\n' | sort)
}

# first3 ITEM...: up to three items, and how many more there are.
first3() {
  local more=$(($# - 3))
  printf '%s' "${*:1:3}"
  ((more <= 0)) || printf ' and %d more' "$more"
}

# release_static_check DIR: the checks that do not need the database.
# Prints one line each; returns 1 when one fails.
release_static_check() {
  local dir=$1 v=${1##*/} ok=0 ruby node have_ruby have_node bad
  ruby=$(sed -n 's/^ruby = "\(.*\)"$/\1/p' "$dir/mise.toml" 2>/dev/null)
  node=$(sed -n 's/^node = "\(.*\)"$/\1/p' "$dir/mise.toml" 2>/dev/null)
  have_ruby=$("$TOOLS/bin/ruby" -e 'print RUBY_VERSION' 2>/dev/null || true)
  have_node=$("$TOOLS/bin/node" -v 2>/dev/null || true)
  if [[ -n $ruby && $ruby == "$have_ruby" && "v$node" == "$have_node" ]]; then
    report ok "release $v: runs on the tools in $TOOLS (ruby $ruby, node $node)"
  else
    report fail "release $v: wants ruby ${ruby:-?} and node ${node:-?}, and $TOOLS has ruby ${have_ruby:-none} and node ${have_node:-none}; every release runs on the same tools, so changing them needs tools per release (M12)"
    ok=1
  fi
  # M3-n: root runs this code (migrate, use) and the services read it.
  bad=$(find "$dir" -xdev ! -type l \( ! -user root -o -perm /022 \) -print -quit 2>/dev/null)
  if [[ -z $bad ]]; then
    report ok "release $v: owned by root and writable by root only"
  else
    report fail "release $v: $bad is not root's alone (owner or group/other write); rebuild it with install.sh --stage release"
    ok=1
  fi
  if [[ -d $dir/packaging/systemd && -f $dir/packaging/bin/ubicloud-admin && -f $dir/bin/rake-task-runner ]]; then
    report ok "release $v: has its units, ubicloud-admin and bin/rake-task-runner"
  else
    report fail "release $v: lacks packaging/systemd, packaging/bin/ubicloud-admin or bin/rake-task-runner"
    ok=1
  fi
  return "$ok"
}

# The services that must not run while the schema or the release changes.
need_stopped() {
  local running
  running=$(running_services)
  [[ -z $running ]] ||
    usage_die "$running run; stop them first (systemctl stop ubicloud.target ubicloud-web ubicloud-respirate ubicloud-monitor, which waits for them), so no process runs one release on the other's schema"
}

cmd_release() {
  local sub=${1:-}
  shift || true
  case $sub in
    list) release_list "$@" ;;
    check) release_check "$@" ;;
    migrate) release_migrate "$@" ;;
    use) release_use "$@" ;;
    prune) release_prune "$@" ;;
    *) usage_die "release takes list, check VERSION, migrate VERSION, use VERSION or prune --keep N" ;;
  esac
}

release_list() {
  [[ $# -eq 0 ]] || usage_die "release list takes no arguments"
  need_root
  local cur prev d v mark mig db=1
  cur=$(link_version "$CURRENT")
  prev=$(link_version "$PREVIOUS")
  if (load_applied) >/dev/null 2>&1; then load_applied; else db=0; fi
  printf '%-16s %-12s %-20s %-9s %s\n' VERSION REV BUILT ROLE MIGRATIONS
  while IFS= read -r d; do
    v=${d##*/}
    mark=-
    [[ $v != "$prev" ]] || mark=previous
    [[ $v != "$cur" ]] || mark=current
    if [[ $v == *.tmp ]]; then
      printf '%-16s %-12s %-20s %-9s %s\n' "$v" - - - "(an unfinished build; release prune removes it)"
      continue
    fi
    if ((db)); then
      release_gaps "$d"
      if ((${#LACKS[@]})); then
        mig="lacks ${#LACKS[@]} applied (downgrade refused)"
      elif ((${#PENDING[@]})); then
        mig="${#PENDING[@]} to apply (release migrate $v)"
      else
        mig=matches
      fi
    else
      mig="(database not readable)"
    fi
    printf '%-16s %-12s %-20s %-9s %s\n' "$v" "$(sed -n 's/^rev=//p' "$d/.ubicloud-release" | cut -c1-12)" \
      "$(sed -n 's/^built=//p' "$d/.ubicloud-release")" "$mark" "$mig"
  done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%p\n' 2>/dev/null | sort)
}

release_check() {
  [[ $# -eq 1 ]] || usage_die "release check takes one VERSION"
  need_root
  need_release
  local dir rc=0
  dir=$(release_dir "$1")
  release_static_check "$dir" || rc=2
  load_applied
  release_gaps "$dir"
  if ((${#LACKS[@]})); then
    report fail "release $1: the database has ${#LACKS[@]} migration(s) it lacks ($(first3 "${LACKS[@]}")), so it would be a downgrade onto a newer schema; use refuses it (see --for-restore)"
    rc=2
  elif ((${#PENDING[@]})); then
    report notice "release $1: release migrate $1 applies ${#PENDING[@]} migration(s) ($(first3 "${PENDING[@]}"))"
  else
    report ok "release $1: knows every applied migration and has none to apply"
  fi
  local running
  running=$(running_services)
  [[ -z $running ]] || report notice "release: $running run; migrate and use need them stopped"
  return "$rc"
}

# services_stopped_at: STOP_EPOCH, the last time web, respirate or
# monitor ran, and STOP_WHAT, which event that was: the latest stop of
# one of them since boot, or the boot when none ran since. Returns 1 when
# systemd does not say when it booted.
STOP_EPOCH=0 STOP_WHAT=""
services_stopped_at() {
  local u t j
  t=$(systemctl show --timestamp=unix -p UserspaceTimestamp --value 2>/dev/null || true)
  t=${t#@}
  [[ $t =~ ^[0-9]+$ ]] && ((t > 0)) || return 1
  STOP_EPOCH=$t STOP_WHAT="the boot"
  for u in "${SERVICES[@]}"; do
    # InactiveEnterTimestamp is empty for a unit that has not stopped
    # since boot, but also for one systemd unloaded after its stop (an
    # inactive unit nothing refers to, such as when ubicloud.target is
    # disabled), so the unit's last journal entry of this boot counts
    # too. It is stopped now (need_stopped), so it ran no later.
    t=$(systemctl show --timestamp=unix -p InactiveEnterTimestamp --value "$u" 2>/dev/null || true)
    t=${t#@}
    [[ $t =~ ^[0-9]+$ ]] || t=0
    j=$(journalctl -q --no-pager -b -u "$u.service" -n 1 -o short-unix 2>/dev/null | cut -d. -f1 || true)
    if [[ $j =~ ^[0-9]+$ ]] && ((j > t)); then t=$j; fi
    if ((t > STOP_EPOCH)); then
      STOP_EPOCH=$t STOP_WHAT="the stop of $u"
    fi
  done
}

# backup_fits MANIFEST DIR: whether the backup holds the database as it
# is, or as it was before migrations of release DIR that current lacks
# (an earlier release migrate of DIR that failed halfway), with only
# migrations current knows, so that restore --db-only on current takes
# it. FIT_RAN: the migrations that ran since the backup.
FIT_RAN=()
backup_fits() {
  local m=$1 dir=$2 f
  local -A in_backup=()
  FIT_RAN=()
  while IFS= read -r f; do
    [[ -f $CURRENT/migrate/$f ]] || return 1
    in_backup[$f]=1
  done < <(jq -r '.schema_migrations[]' "$m")
  while IFS= read -r f; do
    [[ -f $CURRENT/migrate/ph/$f ]] || return 1
  done < <(jq -r '.schema_migrations_password[]' "$m")
  for f in "${APPLIED[@]}"; do
    if [[ -n ${in_backup[$f]:-} ]]; then
      unset "in_backup[$f]"
    elif [[ -f $dir/migrate/$f && ! -f $CURRENT/migrate/$f ]]; then
      FIT_RAN+=("$f")
    else
      return 1
    fi
  done
  ((${#in_backup[@]} == 0))
}

# release_backup_check DIR: RELEASE_BACKUP, the backup a failed switch to
# release DIR goes back to. It must be newer than the last time the
# services ran (no strand or request ran after it), and backup_fits.
release_backup_check() {
  local dir=$1 target newest d cur
  target=$(backup_target)
  cur=$(link_version "$CURRENT")
  newest=$(latest_backup "$target")
  [[ -n $newest ]] ||
    usage_die "no backup in $target; with the services stopped, run ubicloud-admin backup now first (or pass --skip-backup-check)"
  services_stopped_at ||
    usage_die "systemd does not say when the services last ran, so the age of backup $newest cannot be checked; nothing was changed (pass --skip-backup-check to go on without a backup check)"
  (($(ts_epoch "$newest") >= STOP_EPOCH)) ||
    usage_die "the newest backup ($newest) is older than $STOP_WHAT ($(date -u -d "@$STOP_EPOCH" +%Y%m%dT%H%M%SZ)), so it can lack what ran until then; run ubicloud-admin backup now first (or pass --skip-backup-check)"
  for d in $(backups_newest_first "$target"); do
    (($(ts_epoch "$d") >= STOP_EPOCH)) || break
    backup_fits "$target/$d/manifest.json" "$dir" || continue
    RELEASE_BACKUP=$d
    if ((${#FIT_RAN[@]})); then
      report ok "release: backup $d holds the database as it was before the ${#FIT_RAN[@]} migration(s) of ${dir##*/} that ran already ($(first3 "${FIT_RAN[@]}")); restore $d --db-only undoes them"
    else
      report ok "release: backup $d holds the database as it is (restore $d --db-only undoes the migrations)"
    fi
    return 0
  done
  usage_die "no backup made since $STOP_WHAT holds the database as it is (or as it was before migrations of ${dir##*/} that ran already) with only migrations $cur knows; the newest is $newest (ubicloud-admin backup list). Run ubicloud-admin backup now first, or pass --skip-backup-check when the database already has migrations $cur lacks; nothing was changed"
}

release_migrate() {
  local v="" skip_backup=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --skip-backup-check) skip_backup=1 ;;
      -*) usage_die "unknown release migrate option $1" ;;
      *)
        [[ -z $v ]] || usage_die "release migrate takes one VERSION"
        v=$1
        ;;
    esac
    shift
  done
  [[ -n $v ]] || usage_die "release migrate needs a VERSION (ubicloud-admin release list)"
  need_root
  need_release
  audit "release migrate"
  local dir
  dir=$(release_dir "$v")
  take_lock 600
  make_work
  need_stopped
  release_static_check "$dir" >"$WORK/static" || {
    cat "$WORK/static"
    die "release $v cannot be migrated to (above); nothing was changed" 2
  }
  load_applied
  release_gaps "$dir"
  ((${#LACKS[@]} == 0)) ||
    usage_die "the database has ${#LACKS[@]} migration(s) release $v lacks ($(first3 "${LACKS[@]}")); it is older than the schema, and migrations never run backwards. Restore a backup made before them (release use $v --for-restore TS); nothing was changed"
  if ((${#PENDING[@]} == 0)); then
    report ok "release: $v has no migration to apply (${#APPLIED[@]} applied)"
    return 0
  fi
  RELEASE_BACKUP=""
  if ((skip_backup)); then
    report warn "release: no backup check (--skip-backup-check); without a backup of this schema a failed switch has nothing to go back to"
  else
    release_backup_check "$dir"
  fi
  SERVICE_RELEASE=$dir
  if ! ruby_as ubicloud-migrate bin/rake-task-runner migrate "" 0 >"$WORK/migrate.log" 2>&1; then
    grep -v -i 'password' "$WORK/migrate.log" | tail -20 >&2
    load_applied
    die "the migrations of release $v failed; the database keeps the ${#APPLIED[@]} that ran (each migration is one transaction) and the services stay stopped. Fix the cause and run release migrate $v again, with the services still stopped (it goes on from backup ${RELEASE_BACKUP:-TS}; no new backup is needed), or go back with ubicloud-admin restore ${RELEASE_BACKUP:-TS} --db-only (current is still $(link_version "$CURRENT"))"
  fi
  load_applied
  release_gaps "$dir"
  ((${#PENDING[@]} == 0)) || die "release $v still has ${#PENDING[@]} migration(s) to apply after the run ($(first3 "${PENDING[@]}"))"
  report changed "release: applied the migrations of $v (${#APPLIED[@]} applied now); current is still $(link_version "$CURRENT"), switch with release use $v"
}

# release_install_file SRC DEST MODE: installs SRC at DEST through a
# rename, so a running copy (this script) keeps its own file. Returns 1
# when DEST already matched.
release_install_file() {
  cmp -s "$1" "$2" && return 1
  install -m "$3" -o root -g root "$1" "$2.new"
  mv -f "$2.new" "$2"
}

# hold_set VERSION TS: until restore TS lifts it, drop-ins keep web,
# respirate and monitor from starting (an assertion, so a manual start
# fails visibly; also at boot), and make the backup timer's runs skip.
hold_set() {
  local u d
  secure_state
  # $STATE is root's now, but an older layout let ubicloud plant a
  # symlink here; noclobber creates the file with O_EXCL.
  rm -f "$HOLD.new"
  (
    set -C
    printf 'version=%s\nrestore=%s\n' "$1" "$2" >"$HOLD.new"
  ) || die "cannot create $HOLD.new"
  chmod 0644 "$HOLD.new"
  mv -f "$HOLD.new" "$HOLD"
  for u in "${SERVICES[@]}" ubicloud-backup; do
    d=$UNIT_DIR/$u.service.d
    install -d -m 0755 -o root -g root "$d"
    {
      echo "# ubicloud-admin release use --for-restore: current does not know the"
      echo "# database's schema until ubicloud-admin restore swaps the database;"
      echo "# the restore removes this file."
      echo "[Unit]"
      if [[ $u == ubicloud-backup ]]; then
        echo "ConditionPathExists=!$HOLD"
      else
        echo "AssertPathExists=!$HOLD"
      fi
    } >"$d/$HOLD_DROPIN.new"
    chmod 0644 "$d/$HOLD_DROPIN.new"
    mv -f "$d/$HOLD_DROPIN.new" "$d/$HOLD_DROPIN"
  done
  systemctl daemon-reload
  report changed "release: web, respirate and monitor are held (they do not start, not even at boot) until ubicloud-admin restore $2 --db-only"
}

# hold_clear: lifts the hold of hold_set, once the database and current
# agree.
hold_clear() {
  local u d held=0
  [[ ! -e $HOLD ]] || held=1
  for u in "${SERVICES[@]}" ubicloud-backup; do
    d=$UNIT_DIR/$u.service.d
    [[ -e $d/$HOLD_DROPIN ]] || continue
    held=1
    rm -f "$d/$HOLD_DROPIN"
    rmdir "$d" 2>/dev/null || true
  done
  ((held)) || return 0
  rm -f "$HOLD"
  systemctl daemon-reload
  report changed "release: the hold of release use --for-restore is lifted"
}

release_use() {
  local v="" for_restore=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --for-restore)
        [[ $# -ge 2 && $2 =~ $TS_RE ]] || usage_die "--for-restore needs a backup timestamp such as 20261014T031500Z (ubicloud-admin backup list)"
        for_restore=$2
        shift
        ;;
      -*) usage_die "unknown release use option $1" ;;
      *)
        [[ -z $v ]] || usage_die "release use takes one VERSION"
        v=$1
        ;;
    esac
    shift
  done
  [[ -n $v ]] || usage_die "release use needs a VERSION (ubicloud-admin release list)"
  need_root
  need_release
  audit "release use"
  local dir cur
  dir=$(release_dir "$v")
  take_lock 600
  make_work
  cur=$(link_version "$CURRENT")
  if [[ $cur == "$v" && -z $for_restore ]]; then
    report ok "release: $v is current"
    return 0
  fi
  need_stopped
  release_static_check "$dir" >"$WORK/static" || {
    cat "$WORK/static"
    die "release $v cannot be used (above); nothing was changed" 2
  }
  load_applied
  release_gaps "$dir"
  if [[ -n $for_restore ]]; then
    local m f missing=()
    m=$(backup_target)/$for_restore/manifest.json
    [[ -f $m ]] || usage_die "$m does not exist (ubicloud-admin backup list)"
    while IFS= read -r f; do
      [[ -f $dir/migrate/$f ]] || missing+=("$f")
    done < <(jq -r '.schema_migrations[]' "$m")
    while IFS= read -r f; do
      [[ -f $dir/migrate/ph/$f ]] || missing+=("ph/$f")
    done < <(jq -r '.schema_migrations_password[]' "$m")
    ((${#missing[@]} == 0)) ||
      usage_die "backup $for_restore has ${#missing[@]} migration(s) release $v lacks ($(first3 "${missing[@]}")), so restore would refuse it; pick a backup that $v made; nothing was changed"
    ((${#LACKS[@]} == 0)) ||
      report warn "release: the database has ${#LACKS[@]} migration(s) $v lacks ($(first3 "${LACKS[@]}")); do not start the services before ubicloud-admin restore $for_restore --db-only"
  else
    ((${#LACKS[@]} == 0)) ||
      usage_die "downgrade refused: the database has ${#LACKS[@]} migration(s) release $v lacks ($(first3 "${LACKS[@]}")), and $v would run on a schema it does not know. Go back to a backup made before them: release use $v --for-restore TS, then restore TS --db-only (docs/byoh/OPERATIONS.md, release switch); nothing was changed"
    ((${#PENDING[@]} == 0)) ||
      usage_die "release $v has ${#PENDING[@]} migration(s) the database lacks ($(first3 "${PENDING[@]}")); run ubicloud-admin release migrate $v first; nothing was changed"
  fi

  # The units and ubicloud-admin of the release, as install.sh installs
  # them from current.
  local u changed=0
  for u in "$dir"/packaging/systemd/*; do
    release_install_file "$u" "$UNIT_DIR/${u##*/}" 0644 && changed=1
  done
  if ((changed)); then
    systemctl daemon-reload
    report changed "release: units installed from $v"
  else
    report ok "release: the units of $v are installed"
  fi
  if grep -q '^cmd_release()' "$dir/packaging/bin/ubicloud-admin"; then
    if release_install_file "$dir/packaging/bin/ubicloud-admin" "$ADMIN_BIN" 0755; then
      report changed "release: installed $ADMIN_BIN from $v"
    fi
  else
    # An older ubicloud-admin could not switch forward again.
    report warn "release: $v's ubicloud-admin has no release command, so $ADMIN_BIN stays as it is"
  fi
  # Held before current moves: nothing may start v on a schema it does
  # not know, not even after a reboot.
  if [[ -n $for_restore ]] && ((${#LACKS[@]} + ${#PENDING[@]})); then
    hold_set "$v" "$for_restore"
  fi
  if [[ -n $cur && $cur != "$v" ]]; then
    ln -sfn "releases/$cur" "$PREVIOUS.new"
    mv -T "$PREVIOUS.new" "$PREVIOUS"
  fi
  ln -sfn "releases/$v" "$CURRENT.new"
  mv -T "$CURRENT.new" "$CURRENT"
  report changed "release: current -> $v${cur:+ (previous: $cur)}"
  # The database and v agree: no hold left from an earlier --for-restore.
  ((${#LACKS[@]} + ${#PENDING[@]})) || hold_clear
  if [[ -n $for_restore ]]; then
    echo "Next, before anything starts the services: sudo ubicloud-admin restore $for_restore --db-only"
  else
    echo "Next: sudo systemctl start ubicloud.target && sudo ubicloud-admin status"
    echo "A front template change of $v needs install.sh again with its usual flags and --version $v."
  fi
}

release_prune() {
  local keep=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --keep)
        [[ $# -ge 2 ]] || usage_die "--keep needs a number"
        keep=$2
        shift
        ;;
      *) usage_die "release prune takes --keep N" ;;
    esac
    shift
  done
  [[ $keep =~ ^[1-9][0-9]*$ ]] || usage_die "release prune needs --keep N, with N at least 1"
  need_root
  need_release
  audit "release prune"
  take_lock 600
  local cur prev d v n=0 kept=0 all=()
  cur=$(link_version "$CURRENT")
  prev=$(link_version "$PREVIOUS")
  # Unfinished builds: install.sh holds the same lock while it builds.
  for d in "$RELEASES"/*.tmp; do
    [[ -d $d ]] || continue
    rm -rf "$d"
    report changed "release: removed the unfinished build ${d##*/}"
  done
  # Newest first, by build time.
  mapfile -t all < <(for d in "$RELEASES"/*/; do
    d=${d%/}
    [[ -f $d/.ubicloud-release ]] || continue
    printf '%s %s\n' "$(sed -n 's/^built=//p' "$d/.ubicloud-release")" "${d##*/}"
  done | sort -r | cut -d' ' -f2)
  for v in "${all[@]}"; do
    if [[ $v == "$cur" || $v == "$prev" ]] || ((kept < keep)); then
      kept=$((kept + 1))
      continue
    fi
    rm -rf "${RELEASES:?}/$v"
    n=$((n + 1))
    report changed "release: removed $v"
  done
  report ok "release: kept $kept (current ${cur:-none}, previous ${prev:-none}), removed $n"
}

# status: the current release against the database's migrations.
status_release() {
  if ! (load_applied) >/dev/null 2>&1; then
    fail_line "release: cannot read the migrations of database $DB_NAME"
    return
  fi
  load_applied
  release_gaps "$CURRENT/"
  local v
  v=$(link_version "$CURRENT")
  if ((${#LACKS[@]})); then
    fail_line "release: the database has ${#LACKS[@]} migration(s) $v lacks ($(first3 "${LACKS[@]}")); restore a backup $v made (docs/byoh/OPERATIONS.md, release switch)"
  elif ((${#PENDING[@]})); then
    fail_line "release: ${#PENDING[@]} migration(s) of $v are not applied ($(first3 "${PENDING[@]}")); ubicloud-admin release migrate $v"
  else
    report ok "release: $v matches the database's ${#APPLIED[@]} migrations"
  fi
  if [[ -e $HOLD ]]; then
    fail_line "release: the services are held by release use --for-restore until ubicloud-admin restore $(sed -n 's/^restore=//p' "$HOLD") --db-only ($HOLD)"
  fi
  [[ ! -L $PREVIOUS ]] || report ok "release: previous is $(link_version "$PREVIOUS")"
}

# --- main -------------------------------------------------------------------------------

main() {
  CALLER_PWD=$PWD
  local command=${1:-}
  shift || true
  if [[ $command == --dev ]]; then
    DEV=1
    command=${1:-}
    shift || true
  fi
  # run, account, site, host and pool pass --help to the tool.
  if [[ $command != run && $command != account && $command != site && $command != host && $command != pool ]]; then
    local a
    for a in "$@"; do
      if [[ $a == -h || $a == --help ]]; then
        usage
        return 0
      fi
    done
  fi
  case $command in
    status) cmd_status "$@" ;;
    smoke) cmd_smoke "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    env) cmd_env "$@" ;;
    logs) cmd_logs "$@" ;;
    account) cmd_account "$@" ;;
    run) cmd_run "$@" ;;
    site) cmd_byoh site byoh-location "$@" ;;
    host) cmd_byoh host byoh-host "$@" ;;
    pool) cmd_byoh pool byoh-pool "$@" ;;
    console) cmd_console "$@" ;;
    release) cmd_release "$@" ;;
    -h | --help | help) usage ;;
    "")
      usage >&2
      exit 2
      ;;
    *) usage_die "unknown command $command (see --help)" ;;
  esac
}

main "$@"
